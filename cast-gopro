#!/usr/bin/env python3
"""Play material from the GoPro cloud on a TV - without downloading it.

    cast-gopro --token eyJhbGc...      store a browser token (once)
    cast-gopro                         list recent media
    cast-gopro 3                       cast the third entry
    cast-gopro https://gopro.com/v/AbC public share link
"""
import argparse
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import castcloud as cc  # noqa: E402

API = "https://api.gopro.com"
MEDIA_ACCEPT = "application/vnd.gopro.jk.media+json; version=2.0.0"
IMAGE_TYPES = ("jpg", "jpeg", "png", "heic", "webp")
TOKEN_FILE = os.path.join(cc.CONFIG, "gopro-token")
HOW_TO_GET_A_TOKEN = """
The token comes from a logged-in browser and lasts a few hours:

  1. open https://gopro.com/media-library/ and sign in
  2. F12 -> Application -> Storage -> Cookies -> https://gopro.com
  3. copy the value of gp_access_token (it starts with eyJ)
     or: F12 -> Network -> any api.gopro.com request -> Request Headers ->
         the part of "authorization" after "Bearer "
  4. %s --token eyJhbGc...
""" % cc.how_to_run("cast-gopro")


def token(explicit=None):
    if explicit:
        return explicit.strip()
    if os.environ.get("GOPRO_TOKEN"):
        return os.environ["GOPRO_TOKEN"].strip()
    try:
        with open(TOKEN_FILE) as fh:
            return fh.read().strip()
    except FileNotFoundError:
        cc.die("No GoPro token stored." + HOW_TO_GET_A_TOKEN)


def save_token(value):
    value = value.strip()
    # pasting twice in a row yields two copies glued together; the symmetry shows it
    if len(value) % 2 == 0 and value[:len(value) // 2] == value[len(value) // 2:]:
        value = value[:len(value) // 2]
        print("The token was pasted twice - storing one copy.")
    os.makedirs(cc.CONFIG, exist_ok=True)
    with open(TOKEN_FILE, "w") as fh:
        fh.write(value)
    os.chmod(TOKEN_FILE, 0o600)
    # chmod on Windows only moves the read-only flag, so do not claim a mode there
    print("Token stored in %s%s." % (
        TOKEN_FILE, "" if os.name == "nt" else " (yours only, mode 0600)"))


def api(path, tok, params=None):
    url = API + path + ("?" + params if params else "")
    status, body, _ = cc.fetch(url, headers={
        "Authorization": "Bearer " + tok, "Accept": MEDIA_ACCEPT})
    if status == 401:
        cc.die("GoPro rejected the token (401) - expired or incomplete."
               + HOW_TO_GET_A_TOKEN)
    if status >= 400:
        cc.die("GoPro answered %d:\n%s" % (status, body[:400]))
    try:
        return json.loads(body)
    except ValueError:
        cc.die("GoPro's answer is not JSON:\n%s" % body[:400])


def list_media(tok, count):
    data = api("/media/search", tok, params=(
        "fields=id,filename,captured_at,content_title,file_size,type,resolution,"
        "source_duration&order_by=captured_at&per_page=%d&page=1" % count))
    media = data.get("_embedded", {}).get("media")
    if media is None:
        cc.die("Unfamiliar answer from GoPro (keys: %s).\n"
               "Send it over and the parser can be adjusted." % ", ".join(data)[:200])
    items = []
    for m in media:
        items.append({
            "id": m.get("id"),
            "name": m.get("content_title") or m.get("filename") or m.get("id"),
            "date": (m.get("captured_at") or "")[:10],
            "kind": m.get("type", ""),
            "size": m.get("file_size"),
            "res": m.get("resolution", ""),
            # source_duration is milliseconds; the API has no "duration"
            # field at all, which is why asking for one returned nothing
            "ms": m.get("source_duration"),
        })
    cc.cache_write("gopro-list.json", items)
    return items


def show(items):
    if not items:
        print("The library is empty, or the filter matched nothing.")
        return
    width = max(len(i["name"]) for i in items)
    for n, i in enumerate(items, 1):
        print("%3d. %-*s  %s  %-6s %8s  %s" % (
            n, width, i["name"], i["date"] or "----------",
            i["res"] or "", cc.human(i["size"]), i["kind"]))
    print("\nCast one:  %s <number>" % cc.how_to_run("cast-gopro"))


def _rank(label):
    """Lower is better. The names come from what the API actually returns."""
    return {"source": 0, "high_res_proxy_mp4": 1, "high": 1, "high_res": 1,
            "mobile": 2, "file": 2, "edit_proxy": 3, "low": 4}.get(
        (label or "").lower(), 5)


def library_url(media_id, tok, quality="auto"):
    """Signed address for a cloud entry: the best video variant, or the still.

    A Photo item carries one variation and it is the picture. Before this told
    them apart, the jpg variation was filtered out as "not video", leaving only
    the files entry - which the CDN labels binary/octet-stream, so it passed as
    video, was announced to the TV as a videoItem, and the TV answered that the
    file is not supported.
    """
    data = api("/media/%s/download" % media_id, tok)
    emb = data.get("_embedded", {})
    plays, stills = [], []
    for var in emb.get("variations", []) or []:
        kind = (var.get("type") or "").lower()
        entry = (_rank(var.get("label")), var.get("label", "?"), var.get("url"))
        if kind in ("mp4", "video", ""):
            plays.append(entry)
        elif kind in IMAGE_TYPES:
            stills.append(entry)
    # not the source: for the media tested these were 1280 px proxies
    files = [(_rank("file"), "file", f.get("url"))
             for f in emb.get("files", []) or []]

    if stills and not plays:
        stills = [s for s in stills if s[2]]
        stills.sort(key=lambda o: o[0])
        if stills:
            print("  still: %s" % stills[0][1])
            return stills[0][2]

    options = [o for o in plays + files if o[2]]
    if not options:
        cc.die("No download address in GoPro's answer (keys: %s).\n"
               "Send the JSON over and the parser can be adjusted."
               % (", ".join(emb) or "-"))
    options.sort(key=lambda o: o[0])
    if quality == "proxy":          # a deliberately lighter file
        options = [o for o in options if o[0] > 0] or options
    elif quality == "source":
        options = [o for o in options if o[0] == 0] or options
    for _, label, url in options:
        info = cc.is_video(url)
        if info:
            print("  quality: %s (%s, %s)" % (label, info[0], cc.human(info[1])))
            return url
    print("  ! no variant confirmed itself as video, taking the first one")
    return options[0][2]


def share_url(url):
    """Public gopro.com/v/... link - the address sits in JSON on the page."""
    _, html, _ = cc.fetch(url)
    found = re.findall(r'https?://[^"\'\\ ]+?\.mp4[^"\'\\ ]*', html)
    # longest first: a signed source link is longer than a thumbnail's
    for candidate in sorted(set(found), key=len, reverse=True):
        candidate = candidate.replace("\\u0026", "&").replace("\\/", "/")
        if cc.is_video(candidate):
            return candidate
    cc.die("No stream found on that page.\n"
           "Check the link is public (Share -> Copy link).")


def main():
    ap = argparse.ArgumentParser(description="Play GoPro cloud material on a TV.")
    ap.add_argument("what", nargs="?",
                    help="number from the listing, media id, or a gopro.com/v/... link")
    ap.add_argument("--token", help="store an access token from the browser and exit")
    ap.add_argument("-n", "--count", type=int, default=25, help="how many entries to list")
    ap.add_argument("-q", "--quality", choices=("auto", "source", "proxy"), default="auto",
                    help="auto takes the best variant, proxy a lighter preview")
    ap.add_argument("-t", "--tv", help="TV address")
    ap.add_argument("-p", "--port", type=int, help="HTTP port for cast-tv to serve on")
    ap.add_argument("--url-only", action="store_true",
                    help="print the address instead of casting it")
    args = ap.parse_args()

    if args.token:
        save_token(args.token)
        return 0

    if args.what and args.what.startswith(("http://", "https://")):
        url, title = share_url(args.what), None
    elif args.what:
        tok = token()
        items = cc.cache_read("gopro-list.json")
        if args.what.isdigit() and items and 1 <= int(args.what) <= len(items):
            item = items[int(args.what) - 1]
        elif args.what.isdigit():
            cc.die("No listing cached - run `%s` first." % cc.how_to_run("cast-gopro"))
        else:
            item = {"id": args.what, "name": args.what}
        print("Resolving: %s" % item["name"])
        url, title = library_url(item["id"], tok, args.quality), item["name"]
    else:
        show(list_media(token(), args.count))
        return 0

    if args.url_only:
        print(url)
        return 0
    return cc.cast(url, tv=args.tv, port=args.port, title=title)


if __name__ == "__main__":
    sys.exit(main())
