# ai-toolkit installs authoring skills into this checkout. None of it is
# published from here: the managed skills carry unresolved licences, and the
# recovery channel is course material that must never be tracked in a public
# repository. Same list as lumina-clean-ai uses.
.claude/skills/*/
.agents/skills/*/
.claude/prompts/
.claude/config-templates/
.claude/.10x-cli-manifest.json
.claude/settings.local.json
scripts/local/
.ai-toolkit/
