#!/usr/bin/env python3
"""Play a local file - or relay a remote stream - on a Samsung TV over DLNA.

    cast-tv film.mkv
    cast-tv film.mkv -s subtitles.srt
    cast-tv "https://example.com/clip.mp4"
    cast-tv --stop
"""
import argparse, http.cookiejar, http.server, json, os, re, socket, socketserver
import subprocess, sys, threading, time
import urllib.parse, urllib.request
from xml.sax.saxutils import escape, unescape

SSDP_ADDR, SSDP_PORT = "239.255.255.250", 1900
AVT = "urn:schemas-upnp-org:service:AVTransport:1"
RC = "urn:schemas-upnp-org:service:RenderingControl:1"
CHUNK = 256 * 1024

MIME = {".mkv": "video/x-matroska", ".mp4": "video/mp4", ".m4v": "video/mp4",
        ".avi": "video/x-msvideo", ".mov": "video/quicktime", ".ts": "video/mpeg",
        ".m2ts": "video/mp2t", ".mpg": "video/mpeg", ".mpeg": "video/mpeg",
        ".webm": "video/webm", ".wmv": "video/x-ms-wmv", ".mp3": "audio/mpeg",
        ".flac": "audio/flac", ".m4a": "audio/mp4", ".srt": "application/x-subrip",
        ".smi": "application/smil", ".ass": "text/plain", ".vtt": "text/vtt"}

DLNA_FEATURES = ("DLNA.ORG_OP=01;DLNA.ORG_CI=0;DLNA.ORG_FLAGS="
                 "01700000000000000000000000000000")


# ----------------------------------------------------------------- discovery
def discover(timeout=4):
    """Return [(ip, control_url, friendly_name)] for renderers on the network."""
    msg = ("M-SEARCH * HTTP/1.1\r\nHOST:%s:%d\r\nMAN:\"ssdp:discover\"\r\n"
           "MX:2\r\nST:urn:schemas-upnp-org:device:MediaRenderer:1\r\n\r\n"
           % (SSDP_ADDR, SSDP_PORT)).encode()
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.settimeout(timeout)
    s.sendto(msg, (SSDP_ADDR, SSDP_PORT))
    found, deadline = {}, time.time() + timeout
    while time.time() < deadline:
        try:
            data, addr = s.recvfrom(65507)
        except socket.timeout:
            break
        m = re.search(r"(?i)^location:\s*(\S+)", data.decode("utf-8", "replace"), re.M)
        if m and addr[0] not in found:
            found[addr[0]] = m.group(1)
    out = []
    for ip, loc in found.items():
        try:
            xml = urllib.request.urlopen(loc, timeout=3).read().decode("utf-8", "replace")
        except Exception:
            continue
        ctrl = service_control_url(xml, AVT)
        if ctrl:
            name = re.search(r"<friendlyName>(.*?)</friendlyName>", xml, re.S)
            out.append((ip, urllib.parse.urljoin(loc, ctrl),
                        unescape(name.group(1), {"&quot;": '"', "&apos;": "'"})
                        if name else ip))
    return out


def service_control_url(xml, svc_type):
    for blob in re.findall(r"<service>(.*?)</service>", xml, re.S):
        if svc_type in blob:
            m = re.search(r"<controlURL>(.*?)</controlURL>", blob, re.S)
            if m:
                return m.group(1).strip()
    return None


def control_urls(ip):
    """Control endpoints for the TV's AVTransport and RenderingControl."""
    for port, path in ((9197, "/dmr"), (7676, "/dmr"), (9197, "/"), (52235, "/dmr")):
        loc = "http://%s:%d%s" % (ip, port, path)
        try:
            xml = urllib.request.urlopen(loc, timeout=3).read().decode("utf-8", "replace")
        except Exception:
            continue
        avt = service_control_url(xml, AVT)
        if avt:
            return (urllib.parse.urljoin(loc, avt),
                    urllib.parse.urljoin(loc, service_control_url(xml, RC) or ""))
    return None, None


# ---------------------------------------------------------------------- SOAP
def soap(url, svc, action, body=""):
    env = ('<?xml version="1.0"?><s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/"'
           ' s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"><s:Body>'
           '<u:{a} xmlns:u="{s}"><InstanceID>0</InstanceID>{b}</u:{a}>'
           "</s:Body></s:Envelope>").format(a=action, s=svc, b=body)
    req = urllib.request.Request(url, env.encode(), {
        "Content-Type": 'text/xml; charset="utf-8"',
        "SOAPAction": '"%s#%s"' % (svc, action)})
    return urllib.request.urlopen(req, timeout=10).read().decode("utf-8", "replace")


def tag(xml, name):
    m = re.search(r"<%s>(.*?)</%s>" % (name, name), xml, re.S)
    return m.group(1) if m else ""


# -------------------------------------------------------------- file serving
class RangeHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    files = {}          # url path -> path on disk
    remote = {}         # url path -> upstream url (relay mode)
    debug = False       # log what the TV asks for
    opener = None       # urllib opener carrying cookies, for relay mode
    caption_url = None

    def log_message(self, *a):
        pass

    def dbg(self, msg):
        if self.debug:
            sys.stderr.write("\n   [tv] %s\n" % msg)
            sys.stderr.flush()

    def _resolve(self):
        path = urllib.parse.unquote(self.path.split("?")[0])
        return self.files.get(path)

    def _headers(self, disk, size, start, end, partial):
        self.dbg("%s %s  Range=%s -> %d-%d/%d" % (
            self.command, self.path, self.headers.get("Range", "-"), start, end, size))
        ext = os.path.splitext(disk)[1].lower()
        self.send_response(206 if partial else 200)
        self.send_header("Content-Type", MIME.get(ext, "application/octet-stream"))
        self.send_header("Content-Length", str(end - start + 1))
        self.send_header("Accept-Ranges", "bytes")
        if partial:
            self.send_header("Content-Range", "bytes %d-%d/%d" % (start, end, size))
        # headers DLNA renderers expect
        self.send_header("transferMode.dlna.org", "Streaming")
        self.send_header("contentFeatures.dlna.org", DLNA_FEATURES)
        if self.caption_url and ext not in (".srt", ".smi", ".ass", ".vtt"):
            self.send_header("CaptionInfo.sec", self.caption_url)
        self.end_headers()

    def _range(self, size):
        rng = self.headers.get("Range")
        if not rng:
            return 0, size - 1, False
        m = re.match(r"bytes=(\d*)-(\d*)", rng)
        if not m:
            return 0, size - 1, False
        a, b = m.group(1), m.group(2)
        if a == "":                       # bytes=-N (tail of the file)
            start, end = max(0, size - int(b)), size - 1
        else:
            start = int(a)
            end = int(b) if b else size - 1
        return start, min(end, size - 1), True

    # ---- relay mode: we fetch over HTTPS / with cookies, the TV gets plain HTTP
    def _remote(self):
        path = urllib.parse.unquote(self.path.split("?")[0])
        return self.remote.get(path)

    def _proxy(self, body=True):
        upstream = self._remote()
        wanted = self.headers.get("Range")
        start = end = None
        m = re.match(r"bytes=(\d+)-(\d*)", wanted or "")
        if m:
            start = int(m.group(1))
            end = int(m.group(2)) if m.group(2) else None

        req = urllib.request.Request(upstream, headers={
            "User-Agent": "Mozilla/5.0", "Accept": "*/*"})
        if wanted:
            req.add_header("Range", wanted)
        self.dbg("%s %s  Range=%s" % (self.command, self.path, wanted or "-"))
        try:
            resp = (self.opener or urllib.request).urlopen(req, timeout=30)
        except Exception as e:
            sys.stderr.write("\n   ! upstream refused: %s\n" % e)
            self.send_error(502); return

        with resp:
            length = resp.headers.get("Content-Length")
            self.dbg("upstream: %s %s, %s bytes" % (
                resp.status, resp.headers.get("Content-Type", "?"), length or "?"))

            # The upstream may ignore Range and hand back the whole file. The TV
            # is waiting for bytes at an offset, would receive the start of the
            # file instead, and would quietly stop - so trim the range ourselves.
            trim = start is not None and resp.status != 206
            total = int(length) if (length or "").isdigit() else None
            # Samsung is fussy about Content-Type: when the upstream says
            # something generic and the path looks like video, name it properly.
            ctype = resp.headers.get("Content-Type") or ""
            if not ctype.startswith("video/"):
                ext = os.path.splitext(urllib.parse.urlparse(upstream).path)[1].lower()
                if ext in MIME:
                    ctype = MIME[ext]

            if trim and total:
                last = min(end if end is not None else total - 1, total - 1)
                if start > last:
                    self.send_response(416)
                    self.send_header("Content-Range", "bytes */%d" % total)
                    self.end_headers(); return
                self.send_response(206)
                if ctype:
                    self.send_header("Content-Type", ctype)
                self.send_header("Content-Range", "bytes %d-%d/%d" % (start, last, total))
                self.send_header("Content-Length", str(last - start + 1))
                self.send_header("Accept-Ranges", "bytes")
                to_send = last - start + 1
                self.dbg("trimming range on upstream's behalf: %d-%d/%d"
                         % (start, last, total))
            else:
                self.send_response(resp.status)
                if ctype:
                    self.send_header("Content-Type", ctype)
                for h in ("Content-Length", "Content-Range", "Accept-Ranges"):
                    if resp.headers.get(h):
                        self.send_header(h, resp.headers[h])
                if not resp.headers.get("Accept-Ranges"):
                    self.send_header("Accept-Ranges", "bytes")
                to_send = None
                if trim:      # unknown length: all we can do is skip and run on
                    self.close_connection = True

            self.send_header("transferMode.dlna.org", "Streaming")
            self.send_header("contentFeatures.dlna.org", DLNA_FEATURES)
            self.end_headers()
            if not body:
                return

            try:
                if trim:                       # skip to the requested offset
                    left = start
                    while left > 0:
                        chunk = resp.read(min(CHUNK, left))
                        if not chunk:
                            return
                        left -= len(chunk)
                while to_send is None or to_send > 0:
                    chunk = resp.read(CHUNK if to_send is None else min(CHUNK, to_send))
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    if to_send is not None:
                        to_send -= len(chunk)
            except (BrokenPipeError, ConnectionResetError):
                pass

    def do_HEAD(self):
        if self._remote():
            self._proxy(body=False); return
        disk = self._resolve()
        if not disk:
            self.send_error(404); return
        size = os.path.getsize(disk)
        start, end, partial = self._range(size)
        self._headers(disk, size, start, end, partial)

    def do_GET(self):
        if self._remote():
            self._proxy(); return
        disk = self._resolve()
        if not disk:
            self.send_error(404); return
        size = os.path.getsize(disk)
        start, end, partial = self._range(size)
        self._headers(disk, size, start, end, partial)
        remaining = end - start + 1
        try:
            with open(disk, "rb") as fh:
                fh.seek(start)
                while remaining > 0:
                    chunk = fh.read(min(CHUNK, remaining))
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    remaining -= len(chunk)
        except (BrokenPipeError, ConnectionResetError):
            pass          # the TV seeked elsewhere or closed the connection


class Server(socketserver.ThreadingTCPServer):
    daemon_threads = True
    allow_reuse_address = True


def local_ip(target):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.connect((target, 9197))
    ip = s.getsockname()[0]
    s.close()
    return ip


# ------------------------------------------------------------------ metadata
def didl(url, title, disk, caption=None):
    ext = os.path.splitext(disk)[1].lower()
    mime = MIME.get(ext, "video/mpeg")
    cap = ('<sec:CaptionInfoEx sec:type="%s">%s</sec:CaptionInfoEx>'
           % (os.path.splitext(caption[0])[1].lstrip(".").lower(), escape(caption[1]))
           if caption else "")
    return ('&lt;DIDL-Lite xmlns="urn:schemas-upnp-org:metadata-1-0/DIDL-Lite/" '
            'xmlns:dc="http://purl.org/dc/elements/1.1/" '
            'xmlns:upnp="urn:schemas-upnp-org:metadata-1-0/upnp/" '
            'xmlns:sec="http://www.sec.co.kr/"&gt;'
            '&lt;item id="1" parentID="0" restricted="1"&gt;'
            "&lt;dc:title&gt;%s&lt;/dc:title&gt;"
            "&lt;upnp:class&gt;object.item.videoItem&lt;/upnp:class&gt;%s"
            '&lt;res protocolInfo="http-get:*:%s:%s"&gt;%s&lt;/res&gt;'
            "&lt;/item&gt;&lt;/DIDL-Lite&gt;"
            % (escape(title), cap.replace("<", "&lt;").replace(">", "&gt;"),
               mime, DLNA_FEATURES, escape(url)))


def explain_failure(source):
    """After the TV refuses to start: what about this file it may have rejected."""
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries",
             "stream=codec_type,codec_name,width,height,bit_rate",
             "-of", "json", source],
            capture_output=True, text=True, timeout=90).stdout
        streams = json.loads(out).get("streams", [])
    except Exception:
        return
    reasons = []
    for st in streams:
        if st.get("codec_type") == "video":
            w, h = st.get("width") or 0, st.get("height") or 0
            mbit = int(st.get("bit_rate") or 0) / 1e6
            print("   media: %s %dx%d%s" % (
                st.get("codec_name", "?"), w, h,
                ", %.0f Mbit/s" % mbit if mbit else ""))
            if mbit > 60:
                reasons.append("%.0f Mbit/s - DLNA players usually top out near 60" % mbit)
            if h and w and abs(w / h - 16 / 9) > 0.35:
                reasons.append("unusual %dx%d aspect (TVs expect something near 16:9)"
                               % (w, h))
        elif st.get("codec_type") == "audio" and st.get("codec_name") in (
                "dts", "truehd", "mlp"):
            reasons.append("%s audio - Samsung does not decode it" % st["codec_name"])
        elif st.get("codec_type") == "data":
            reasons.append("extra data track (%s)" % st.get("codec_name", "?"))
    for reason in reasons:
        print("   ! %s" % reason)
    if reasons:
        print("   Try a lighter variant:  cast-gopro <n> -q proxy")


def check_codecs(path):
    """Warn about audio the TV cannot decode (DTS, TrueHD)."""
    try:
        out = subprocess.run(["ffprobe", "-v", "error", "-show_entries",
                              "stream=codec_type,codec_name", "-of", "csv=p=0", path],
                             capture_output=True, text=True, timeout=20).stdout
    except Exception:
        return
    bad = [l.split(",")[1] for l in out.strip().splitlines()
           if l.startswith("audio") and l.split(",")[1] in ("dts", "truehd", "mlp")]
    if bad:
        print("  ! %s audio - Samsung cannot decode it, playback will be silent."
              % "/".join(bad))
        print("    Fix with:  ffmpeg -i \"%s\" -c:v copy -c:a eac3 -b:a 640k \"%s\"\n"
              % (path, os.path.splitext(path)[0] + ".eac3.mkv"))


# ---------------------------------------------------------------------- main
def main():
    ap = argparse.ArgumentParser(description="Play a video file on a Samsung TV.")
    ap.add_argument("source", nargs="?",
                    help="video file, or an http(s):// address to relay")
    ap.add_argument("-s", "--subs", help="external subtitle file (.srt)")
    ap.add_argument("-t", "--tv", default=os.environ.get("CAST_TV"),
                    help="TV address (default: discover it)")
    ap.add_argument("-p", "--port", type=int, default=8895, help="HTTP port to serve on")
    ap.add_argument("--title", help="name to show instead of the file name")
    ap.add_argument("-d", "--debug", action="store_true",
                    help="log every request the TV makes")
    ap.add_argument("--stop", action="store_true", help="stop playback and exit")
    ap.add_argument("--list", dest="list_devices", action="store_true",
                    help="list discovered renderers")
    ap.add_argument("-c", "--cookies", metavar="FILE",
                    help="Netscape cookie jar, for material behind a login")
    args = ap.parse_args()

    if args.list_devices:
        for ip, url, name in discover():
            print("%-16s %s" % (ip, name))
        return 0

    ip = args.tv
    if not ip:
        print("Looking for a TV...")
        devs = discover()
        if not devs:
            print("No DLNA renderer answered. Switch the TV on and try again,\n"
                  "or name it directly: cast-tv -t 192.168.1.50 film.mkv")
            return 1
        ip, _, name = devs[0]
        print("Found: %s (%s)" % (name, ip))

    avt, rc = control_urls(ip)
    if not avt:
        print("%s does not expose AVTransport (switched off?)." % ip)
        return 1

    if args.stop:
        soap(avt, AVT, "Stop")
        print("Stopped.")
        return 0

    if not args.source:
        ap.error("give a file or an address to play (or --stop / --list)")

    relaying = args.source.startswith(("http://", "https://"))
    host = local_ip(ip)
    base = "http://%s:%d" % (host, args.port)

    if relaying:
        # nothing is written to disk - we only pass the stream through
        name = os.path.basename(urllib.parse.urlparse(args.source).path) or "stream"
        if "." not in name:
            name += ".mp4"
        vpath = "/proxy/" + urllib.parse.unquote(name)
        RangeHandler.remote = {vpath: args.source}
        if args.cookies:
            jar = http.cookiejar.MozillaCookieJar()
            try:
                jar.load(os.path.abspath(args.cookies), ignore_discard=True,
                         ignore_expires=True)
            except Exception as e:
                print("Could not read the cookie jar: %s" % e)
                return 1
            RangeHandler.opener = urllib.request.build_opener(
                urllib.request.HTTPCookieProcessor(jar))
            print("  cookies: %d from %s" % (len(jar), args.cookies))
        path = name
    else:
        path = os.path.abspath(args.source)
        if not os.path.isfile(path):
            print("No such file: %s" % path)
            return 1
        check_codecs(path)
        # keys are stored decoded (as the handler sees them after unquote),
        # while the URL we hand the TV is encoded
        vpath = "/video/" + os.path.basename(path)
        RangeHandler.files = {vpath: path}

    url = base + urllib.parse.quote(vpath)
    caption = None
    if args.subs:
        sub = os.path.abspath(args.subs)
        subpath = "/sub/" + os.path.basename(sub)
        RangeHandler.files[subpath] = sub
        caption = (sub, base + urllib.parse.quote(subpath))
        RangeHandler.caption_url = caption[1]

    try:
        srv = Server(("0.0.0.0", args.port), RangeHandler)
    except OSError as e:
        print("Cannot bind port %d: %s" % (args.port, e))
        return 1
    RangeHandler.debug = args.debug
    threading.Thread(target=srv.serve_forever, daemon=True).start()

    title = args.title or os.path.splitext(os.path.basename(path))[0]

    try:
        soap(avt, AVT, "SetAVTransportURI",
             "<CurrentURI>%s</CurrentURI><CurrentURIMetaData>%s</CurrentURIMetaData>"
             % (escape(url), didl(url, title, path, caption)))
        soap(avt, AVT, "Play", "<Speed>1</Speed>")
    except Exception as e:
        print("The TV rejected the request: %s" % e)
        return 1

    print("\n>  %s" % title)
    print("   %s %s  ->  %s" % ("relaying through" if relaying else "serving from",
                                base, ip))
    print("   Ctrl+C ends it (playback stops on the TV too)\n")

    started, waited = False, 0
    try:
        while True:
            time.sleep(2)
            try:
                info = soap(avt, AVT, "GetPositionInfo")
                state = tag(soap(avt, AVT, "GetTransportInfo"), "CurrentTransportState")
            except Exception:
                continue
            rel, dur = tag(info, "RelTime"), tag(info, "TrackDuration")
            sys.stdout.write("\r   %-12s %s / %s   " % (state, rel or "-", dur or "-"))
            sys.stdout.flush()
            if state in ("PLAYING", "PAUSED_PLAYBACK"):
                started = True
            elif not started:
                # TRANSITIONING is still an attempt; STOPPED after it is a refusal
                waited += 2
                if waited >= (40 if state == "TRANSITIONING" else 24):
                    print("\n   The TV never started playing.")
                    explain_failure(args.source if relaying else path)
                    break
                continue
            if state == "STOPPED" and started:
                print("\n   Finished.")
                break
    except KeyboardInterrupt:
        print()
        try:
            soap(avt, AVT, "Stop")
        except Exception:
            pass
        print("   Stopped.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
