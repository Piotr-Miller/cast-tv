  /* Phone width, as artboard Phone has it: the header without the address,
     the tabs as one segmented control with short names and no hint line, two
     columns, and a bar with room for a thumb. The artboard has no filter row,
     and "Photos" there names the Google Photos tab, so the filters step aside. */
  @media (max-width: 640px) {
    .full { display: none !important; }
    .short { display: inline !important; }
