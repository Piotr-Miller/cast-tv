<script>
let tab = "gopro", state = null, busy = false;
const data = { gopro: null, onedrive: null, photos: null };
const $ = (id) => document.getElementById(id);

const esc = (s) => String(s == null ? "" : s).replace(/[&<>"]/g,
  (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

function size(n) {
  if (!n) return "?";
  const u = ["B", "KB", "MB", "GB"];
  let i = 0;
  while (n >= 1024 && i < 3) { n /= 1024; i++; }
  return (i > 1 ? n.toFixed(1) : Math.round(n)) + " " + u[i];
}

function clock(s) {
  const m = Math.floor(s / 60), r = s % 60;
  return m + ":" + String(r).padStart(2, "0");
}

function left(seconds) {
  if (seconds <= 0) return "expired";
  const h = Math.floor(seconds / 3600), m = Math.floor((seconds % 3600) / 60);
  return h ? h + "h " + m + "m left" : m + "m left";
}

/* Said on the page rather than in an alert(): a modal dialog blocks everything
   the page does, and a resolver's complaint is usually worth reading twice. */
let saying = null;
function say(text, bad) {
  const box = $("say");
  box.textContent = text || "";
  box.className = bad ? "bad" : "";
  clearTimeout(saying);
  if (text) saying = setTimeout(() => { if ($("say").textContent === text) say(""); },
                                12000);
}

async function api(path, body) {
  const r = await fetch(path, body === undefined ? {} : {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
  return r.json();
}

/* Deliberately redraws only the header and the cast: the poll runs every two
   seconds, and redrawing a tab would wipe a token being pasted or a link half
   typed. Whoever changes the data redraws its own tab afterwards. */
async function refreshState() {
  state = await api("/api/state");
  $("tvname").textContent = state.tv ? "→ " + state.tv : "— no TV chosen";
  drawNow();
}

function drawNow() {
  const c = state && state.cast;
  if (!c || (!c.running && !c.log.length)) { $("now").innerHTML = ""; return; }
  const log = $("now").querySelector("pre");
  const pinned = !log || log.scrollTop + log.clientHeight >= log.scrollHeight - 24;
  $("now").innerHTML =
    '<div class="panel' + (c.running ? " playing" : "") + '">' +
      '<div class="row">' +
        '<strong>' + (c.running ? "Playing" : "Last cast") + ":</strong> " +
        esc(c.title || "?") +
        (c.running ? ' <span class="dim small">' + clock(c.seconds) + "</span>" : "") +
        '<span class="grow"></span>' +
        (c.running ? '<button id="stop">Stop</button>' : "") +
      "</div>" +
      '<div class="small dim" style="margin:6px 0 8px">' +
        esc(c.command || "") + "</div>" +
      "<pre>" + esc(c.log.join("\n")) + "</pre>" +
    "</div>";
  const fresh = $("now").querySelector("pre");
  if (fresh && pinned) fresh.scrollTop = fresh.scrollHeight;
  const stop = $("stop");
  if (stop) stop.onclick = async () => {
    stop.disabled = true;
    state.cast = await api("/api/stop", {});
    drawNow();
  };
}

async function cast(payload, button) {
  if (busy) return;
  busy = true;
  if (button) button.disabled = true;
  const out = await api("/api/cast", payload);
  busy = false;
  if (button) button.disabled = false;
  if (out.error) { say(out.error, true); return; }
  say("");
  state.cast = out;
  drawNow();
}

/* ------------------------------------------------------------------ GoPro */
function drawGopro() {
  const t = state ? state.token : null;
  const d = data.gopro;
  let pill = '<span class="pill">unknown</span>';
  if (t && t.state === "valid") {
    pill = '<span class="pill ' + (t.left < 900 ? "warn" : "ok") + '">token: ' +
           left(t.left) + "</span>";
  } else if (t && t.state === "expired") {
    pill = '<span class="pill bad">token: expired</span>';
  } else if (t && t.state === "missing") {
    pill = '<span class="pill bad">no token</span>';
  }

  let body;
  if (!d) {
    body = '<div class="empty">Loading...</div>';
  } else if (d.asking) {
    body = '<div class="empty">Asking GoPro for the library...</div>';
  } else if (d.error) {
    body = '<div class="err">' + esc(d.error) + "</div>";
  } else if (d.never_listed) {
    body = '<div class="empty">The library has never been listed on this machine ' +
           "&mdash; reload it.</div>";
  } else if (!d.items.length) {
    body = '<div class="empty">The library came back empty.</div>';
  } else {
    body = '<table><thead><tr><th>#</th><th>Name</th><th>Date</th>' +
      '<th>Resolution</th><th class="right">Size</th><th class="right">Quality</th>' +
      "<th></th></tr></thead><tbody>" +
      d.items.map((i, n) =>
        "<tr><td class=\"dim\">" + (n + 1) + '</td><td class="name">' + esc(i.name) +
        '</td><td class="dim small">' + esc(i.date || "") + "</td>" +
        '<td class="dim small">' + esc(i.res || "") + "</td>" +
        '<td class="right dim small">' + size(i.size) + "</td>" +
        '<td class="right"><select data-q="' + (n + 1) + '">' +
          '<option value="auto">auto</option>' +
          '<option value="source">original</option>' +
          '<option value="proxy">proxy</option>' +
        "</select></td>" +
        '<td class="right"><button class="go" data-cast="' + (n + 1) + '" data-title="' +
          esc(i.name) + '">Cast</button></td></tr>').join("") +
      "</tbody></table>";
  }

  $("tab-gopro").innerHTML =
    '<p class="note">The only source that can be browsed. The token is copied out ' +
    "of a logged-in browser and lasts a few hours; when it runs out, paste a new " +
    "one.</p>" +
    '<div class="panel"><div class="row">' + pill +
      '<input id="tok" placeholder="paste gp_access_token (eyJ...)" style="flex:1">' +
      '<button id="savetok">Store it</button>' +
      '<button id="reload">Reload the library</button>' +
    "</div></div>" +
    '<div class="panel">' + body + "</div>";

  $("savetok").onclick = async () => {
    const value = $("tok").value.trim();
    if (!value) return;
    $("savetok").disabled = true;
    const out = await api("/api/gopro/token", { token: value });
    $("savetok").disabled = false;
    if (out.error) { say(out.error, true); return; }
    say("Token stored.");
    $("tok").value = "";
    await refreshState();
    loadGopro(true);
  };
  $("reload").onclick = () => loadGopro(true);
  $("tab-gopro").querySelectorAll("button[data-cast]").forEach((b) => {
    b.onclick = () => {
      const n = Number(b.dataset.cast);
      const q = $("tab-gopro").querySelector('select[data-q="' + n + '"]').value;
      cast({ source: "gopro", index: n, quality: q, title: b.dataset.title }, b);
    };
  });
}

async function loadGopro(refresh) {
  data.gopro = refresh ? { asking: true } : null;
  drawGopro();
  data.gopro = await api("/api/gopro" + (refresh ? "?refresh=1" : ""));
  await refreshState();      // a refresh may have consumed the last of the token
  drawGopro();
}

