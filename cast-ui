function drawPhotos() {
  const hist = (data.photos && data.photos.history) || [];
  $("tab-photos").innerHTML =
    '<p class="note">This cannot be browsed at all: since 31 March 2025 the Library ' +
    "API only exposes items you pick by hand, so the entry point is a link to one " +
