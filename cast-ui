<body>
<header>
  <div class="brand">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e8a33d" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="13" rx="2"></rect><path d="M8 21h8"></path><path d="M12 17v4"></path></svg>
    <span class="mono">cast-tv</span>
    <span class="spill" id="spill" hidden>Slideshow</span>
  </div>
  <div class="tvchip" id="tvchip" title="Look for the TV again"></div>
</header>
<div class="tabsbar" id="tabsbar">
  <div id="tabs"></div>
  <div id="filters"></div>
</div>
<div id="say"></div>
<section id="tab-gopro"></section>
<section id="tab-onedrive" hidden></section>
<section id="tab-photos" hidden></section>
<main id="showview" hidden></main>
<div id="drawer" hidden></div>
<footer id="bar"></footer>
<script>
let tab = "gopro", filter = "all", state = null, busy = false, tokenOpen = false;
let logOpen = false;
const data = { gopro: null, onedrive: null, photos: null };
const quality = {};          // media id -> the variant chosen on its tile
const clicks = new Map();    // tile key -> what casting it means
const $ = (id) => document.getElementById(id);
const esc = (s) => String(s == null ? "" : s).replace(/[&<>"]/g,
  (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

const WARN_ICON = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" ' +
  'stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
  '<path d="M12 9v4"></path><path d="M12 17h.01"></path><path d="M10.3 3.9 1.8 18a2 2 0 0 0 ' +
  '1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg>';
const FOLDER_ICON = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" ' +
  'stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' +
  '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z">' +
  '</path></svg>';

function size(n) {
  if (!n) return "?";
  const u = ["B", "KB", "MB", "GB"];
  let i = 0;
  while (n >= 1024 && i < 3) { n /= 1024; i++; }
  return (i > 2 ? n.toFixed(1) : Math.round(n)) + " " + u[i];
}
function clock(s) { return Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0"); }
function left(seconds) {
  const h = Math.floor(seconds / 3600), m = Math.floor((seconds % 3600) / 60);
  return h ? h + " h " + m + " min" : m + " min";
}
function ago(seconds) {
  if (seconds < 60) return "just now";
  const h = Math.floor(seconds / 3600), m = Math.floor((seconds % 3600) / 60);
  return (h ? h + " h " + m + " min" : m + " min") + " ago";
}
function duration(ms) {
  if (!ms) return "";
  let s = Math.round(ms / 1000);
  const h = Math.floor(s / 3600); s %= 3600;
  const m = Math.floor(s / 60); s %= 60;
  return (h ? h + ":" + String(m).padStart(2, "0") : m) + ":" + String(s).padStart(2, "0");
}
/* The number that decides whether the TV copes is the bit rate, not the size,
   so it is what the tile says once the length is known. */
function mbit(bytes, ms) { return bytes && ms ? Math.round(bytes * 8 / (ms / 1000) / 1e6) : 0; }
function height(res) { const m = /(\d+)p/.exec(res || ""); return m ? +m[1] : 0; }
/* The placeholder behind every picture, and all of it for rows that have none:
   the design's own two-stop gradient, its hue taken from the name. */
function hue(name) { let h = 0; for (const c of name) h = (h * 31 + c.charCodeAt(0)) % 360; return h; }
function gradient(h) {
  return "linear-gradient(148deg, oklch(0.44 0.075 " + h + "), oklch(0.24 0.035 " +
         ((h + 55) % 360) + "))";
}
const QUALITY = ["proxy", "auto", "source"];
const QLABEL = { proxy: "proxy", auto: "auto", source: "original" };

/* Said on the page rather than in an alert(): a modal dialog blocks everything
   the page does, and a resolver's complaint is usually worth reading twice. */
let saying = null;
function say(text, bad) {
  const box = $("say");
  box.textContent = text || "";
  box.className = bad ? "bad" : "";
  clearTimeout(saying);
  if (text) saying = setTimeout(() => { if ($("say").textContent === text) say(""); }, 12000);
}

async function api(path, body) {
  const r = await fetch(path, body === undefined ? {} : {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
  return r.json();
}

/* ------------------------------------------------------------- the token */
/* GoPro's token is encrypted, so nothing here can know when it expires.
   What it can say: when it was stored, and how GoPro answered last. Past
   three hours the amber is a hint - they last a few hours - not knowledge.
   The expiry line is kept for a token that does carry a readable one. */
function tokenHint(t) {
  if (!t || t.state === "missing") return ["no token", "bad"];
  if (t.left != null) {
    return t.left > 0 ? ["token · " + left(t.left) + " left", t.left < 900 ? "warn" : "ok"]
                      : ["token expired", "bad"];
  }
  if (t.download === "rejected") return ["token rejected", "bad"];
  if (t.listing === "rejected") return ["token refused for the list", "warn"];
  if (t.listing === "ok") return ["token working · stored " + ago(t.age), "ok"];
  return ["token stored " + ago(t.age), t.age > 10800 ? "warn" : ""];
}
function tokenNeeded(t) {
  return !t || t.state === "missing" || t.download === "rejected" ||
         t.listing === "rejected" || (t.left != null && t.left <= 0);
}

/* ------------------------------------------------------------ the chrome */
function drawHeader() {
  const tv = state && state.tv;
  $("tvchip").innerHTML = tv
    ? '<span class="dot"></span><span class="tvn">' + esc(state.tv_name || "TV") +
      '</span><span class="tvip mono">' + esc(tv) + "</span>"
    : '<span class="dot off"></span><span class="tvn">No TV chosen · find it</span>';
}

function hms(s) {
  s = Math.max(0, Math.round(s));
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), x = s % 60;
  return (h ? h + ":" + String(m).padStart(2, "0") : m) + ":" + String(x).padStart(2, "0");
}
const PLAY_ICON = '<svg width="13" height="13" viewBox="0 0 24 24" fill="oklch(0.74 0.14 190)" ' +
  'stroke="none"><path d="M8 5v14l11-7z"></path></svg>';
const PAUSE_ICON = '<svg width="13" height="13" viewBox="0 0 24 24" fill="oklch(0.74 0.14 190)" ' +
  'stroke="none"><path d="M7 5h4v14H7zM13 5h4v14h-4z"></path></svg>';
const STOP_ICON = '<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" ' +
  'stroke="none"><rect x="6" y="6" width="12" height="12" rx="1.5"></rect></svg>';

function drawTabs() {
  const [th, tcls] = tokenHint(state && state.token);
  const crumbs = data.onedrive && data.onedrive.crumbs;
  const odHint = crumbs && crumbs.length ? crumbs[crumbs.length - 1].name : "a folder on disk";
  const defs = [["gopro", "GoPro", "GoPro", th, tcls],
                ["onedrive", "OneDrive", "OneDrive", odHint, ""],
                ["photos", "Google Photos", "Photos", "paste a link", ""]];
  $("tabs").innerHTML = defs.map(([id, label, short, hint, cls]) =>
    '<div class="tab' + (id === tab ? " on" : "") + '" data-tab="' + id + '">' +
    '<span class="tl">' + (short === label ? label : '<span class="full">' + label +
    '</span><span class="short">' + short + "</span>") + '</span><span class="th mono ' + cls +
    '">' + esc(hint) + "</span></div>").join("");
  $("tabs").querySelectorAll(".tab").forEach((el) => { el.onclick = () => showTab(el.dataset.tab); });

  const grids = tab === "gopro" || tab === "onedrive";
  $("filters").innerHTML = grids ? [["all", "All"], ["vid", "Videos"], ["pho", "Photos"]].map(
    ([id, label]) => '<div class="filter' + (id === filter ? " on" : "") + '" data-f="' + id +
                     '">' + label + "</div>").join("") : "";
  $("filters").querySelectorAll(".filter").forEach((el) => {
    el.onclick = () => { filter = el.dataset.f; drawTabs(); drawTab(); };
  });
}

/* Deliberately redraws only the header, the tab hints and the bar: the poll
   runs every two seconds, and redrawing a grid would reload its pictures and
   wipe a token being pasted. Whoever changes the data redraws its own tab. */
async function refreshState() {
  state = await api("/api/state");
  drawHeader();
  drawTabs();
  drawView();
}

/* The bar says three things, as the design does: nothing is playing, or what
   is playing and how far along, or - which the design leaves to the States
   board - that it did not play, and the line that says why. */
function fitBar() {
  const h = $("bar").hidden ? 0 : $("bar").offsetHeight;
  document.body.style.paddingBottom = h + "px";
  $("drawer").style.bottom = h + "px";
}
window.addEventListener("resize", () => { if (!$("bar").hidden) fitBar(); });

function drawBar() {
  /* While photos are being picked, the bar is the picking panel from the
     design: how many, a way to let them go, the interval, and the start. */
  if (sel.size && !(state && state.show && state.show.active)) {
    const n = sel.size;
    $("bar").innerHTML =
      '<div class="pcount">' + n + "</div>" +
      '<div class="full"><div class="plabel">' + n + (n === 1 ? " photo selected" : " photos selected") +
      '</div><span class="link pclear" id="clearsel">Clear selection</span></div>' +
      '<span class="grow full"></span><span class="full" style="display:contents">' +
      intervals(iv, "data-iv") + "</span>" +
      '<button class="bstart" id="startshow">' + TV_ICON + "Start slideshow</button>";
    $("drawer").hidden = true;
    $("clearsel").onclick = clearSel;
    $("bar").querySelectorAll("[data-iv]").forEach((el) => {
      el.onclick = () => { setIv(+el.dataset.iv); drawBar(); };
    });
    $("startshow").onclick = startShow;
    fitBar();
    return;
  }
  const c = state && state.cast;
  const hasLog = !!(c && c.log && c.log.length);
  const logBtn = hasLog ? '<button class="bbtn quiet" id="logbtn">' +
                          (logOpen ? "Hide log" : "Log") + "</button>" : "";
  let html;
  if (c && c.running) {
    const phase = c.resolving ? "Resolving the address..." :
      c.tv_state === "PLAYING" ? "" :
      c.tv_state === "PAUSED_PLAYBACK" ? "Paused on the TV" :
      c.tv_state === "TRANSITIONING" ? "Starting on the TV..." :
      c.tv_state === "STOPPED" ? "Stopping..." : "Handing it to the TV...";
    const known = c.duration > 0 && !phase;
    const pct = known ? Math.min(100, 100 * c.position / c.duration) : 0;
    html =
      '<div class="bthumb" style="background:' + gradient(hue(c.title || "")) + '">' +
        (c.thumb ? '<img alt="" src="' + esc(c.thumb) + '" onerror="this.remove()">' : "") +
      "</div>" +
      '<div class="bmain">' +
        '<div class="bname">' + (c.tv_state === "PAUSED_PLAYBACK" ? PAUSE_ICON : PLAY_ICON) +
        '<span class="mono">' + esc(c.title || "") + "</span></div>" +
        '<div class="btrack"><div class="bfill' + (known ? "" : " wait") + '" style="width:' +
        pct.toFixed(1) + '%"></div></div>' +
        '<div class="bsub mono"><span>' +
          (known ? hms(c.position) + " / " + hms(c.duration) : esc(phase)) +
        "</span><span>" + esc(c.meta || "") + "</span></div>" +
      "</div>" + logBtn +
      '<button class="bbtn" id="stop" aria-label="Stop">' + STOP_ICON +
      '<span class="full">Stop</span></button>';
  } else if (c && c.outcome === "failed") {
    html =
      '<span class="bdot bad"></span>' +
      '<div class="bmain"><div class="bfail">Did not play: ' + esc(c.title || "") + "</div>" +
      '<div class="blast mono">' + esc(c.reason || "the command ended without saying why") +
      "</div></div>" +
      (hasLog ? '<button class="bbtn" id="logbtn">' + (logOpen ? "Hide log" : "Why") +
                "</button>" : "");
  } else {
    const idle = state && state.tv ? "Nothing playing \u2014 TV ready"
                                   : "Nothing playing \u2014 no TV chosen";
    const tap = state && state.tv ? "Tap to cast to the TV" : "No TV chosen";
    const last = c && c.title ? (c.outcome === "stopped" ? "stopped: " : "last: ") + c.title : "";
    html = '<span class="bdot"></span><span class="bidle"><span class="full">' + idle +
           '</span><span class="short">' + tap + "</span></span>" +
           (last ? '<span class="blast mono full">\u00b7 ' + esc(last) + "</span>" : "") +
           '<span class="grow full"></span>' + logBtn;
  }
  $("bar").innerHTML = html;
  fitBar();

  const d = $("drawer");
  if (logOpen && hasLog) {
    const pinned = d.hidden || d.scrollTop + d.clientHeight >= d.scrollHeight - 24;
    d.innerHTML = '<div class="cmd mono">' + esc(c.command || "") + "</div><pre>" +
                  esc(c.log.join("\n")) + "</pre>";
    d.hidden = false;
    if (pinned) d.scrollTop = d.scrollHeight;
  } else {
    d.hidden = true;
  }
  const lb = $("logbtn");
  if (lb) lb.onclick = () => { logOpen = !logOpen; drawBar(); };
  const stop = $("stop");
  if (stop) stop.onclick = async () => {
    stop.disabled = true;
    state.cast = await api("/api/stop", {});
    drawBar();
  };
}

async function cast(payload, el) {
  if (busy) return;
  busy = true;
  if (el) el.classList.add("busy");
  const out = await api("/api/cast", payload);
  busy = false;
  if (el) el.classList.remove("busy");
  if (out.error) { say(out.error, true); return; }
  say("");
  state.cast = out;
  drawBar();
}


/* ------------------------------------------------------------ selection */
/* A photo is not cast on its own: clicking one selects it for a slideshow,
   and the selection holds across tabs, as the design has it. A video click
   casts at once and lets the selection go. */
const sel = new Map();
function storedIv() {
  try { const v = +localStorage.getItem("cast-ui.interval"); return [3, 5, 8, 12].includes(v) ? v : 5; }
  catch (e) { return 5; }
}
let iv = storedIv();
function setIv(v) { iv = v; try { localStorage.setItem("cast-ui.interval", String(v)); } catch (e) {} }
/* In place, not by redrawing the grid: a redraw rebuilds every picture, and a
   photo's picture is its whole 3.6 MB source. */
function toggleSel(item) {
  if (sel.has(item.id)) sel.delete(item.id); else sel.set(item.id, item);
  document.querySelectorAll('.tile-wrap[data-k="' + CSS.escape(item.id) + '"]')
    .forEach((el) => el.classList.toggle("on", sel.has(item.id)));
  drawBar();
}
function clearSel() {
  sel.clear();
  document.querySelectorAll(".tile-wrap.on").forEach((el) => el.classList.remove("on"));
  drawBar();
}
const CHECK_ICON = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke-width="3" ' +
  'stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>';
const TV_ICON = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
  'stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" ' +
  'width="20" height="13" rx="2"></rect><path d="M8 21h8"></path></svg>';
const PREV_ICON = '<svg width="15" height="15" viewBox="0 0 24 24" fill="oklch(0.88 0.005 65)" ' +
  'stroke="none"><path d="M18 5v14L7 12z"></path><rect x="4" y="5" width="2.2" height="14" ' +
  'rx="1"></rect></svg>';
const NEXT_ICON = '<svg width="15" height="15" viewBox="0 0 24 24" fill="oklch(0.88 0.005 65)" ' +
  'stroke="none"><path d="M6 5v14l11-7z"></path><rect x="17.8" y="5" width="2.2" height="14" ' +
  'rx="1"></rect></svg>';
const QUEUE_NOW = '<svg width="13" height="13" viewBox="0 0 24 24" fill="#e8a33d" stroke="none" ' +
  'style="flex-shrink:0"><path d="M8 5v14l11-7z"></path></svg>';
function playPauseIcon(paused) {
  return '<svg width="16" height="16" viewBox="0 0 24 24" fill="oklch(0.16 0.02 65)" stroke="none">' +
         '<path d="' + (paused ? "M8 5v14l11-7z" : "M8 5h3v14H8zM13 5h3v14h-3z") + '"></path></svg>';
}
function intervals(current, attr) {
  return '<span class="plbl">Change every</span><div class="ivs">' + [3, 5, 8, 12].map((v) =>
    '<div class="iv' + (v === current ? " on" : "") + '" ' + attr + '="' + v + '">' + v +
    " s</div>").join("") + "</div>";
}

/* -------------------------------------------------------------- the show */
function inShow() { return !!(state && state.show && (state.show.active || state.show.ended)); }

async function startShow() {
  const b = $("startshow");
  if (b) b.disabled = true;
  const items = [...sel.values()].map((x) => x.source === "onedrive"
    ? { source: "onedrive", path: x.path, meta: x.meta }
    : { source: x.source, id: x.id, meta: x.meta });
  const out = await api("/api/show", { action: "start", items, interval: iv });
  if (out.error) { if (b) b.disabled = false; say(out.error, true); return; }
  sel.clear();
  state.show = out;
  drawView();
}

async function showAction(body) {
  state.show = await api("/api/show", body);
  drawView();
}

/* The library and the slideshow take turns on the page: the slideshow has its
   own controls at the bottom, so the tabs, the grid and the cast bar step aside. */
let shown = "";
function drawView() {
  const on = inShow();
  $("showview").hidden = !on;
  $("spill").hidden = !on;
  $("tabsbar").hidden = on;
  $("bar").hidden = on;
  fitBar();
  ["gopro", "onedrive", "photos"].forEach((n) => { $("tab-" + n).hidden = on || n !== tab; });
  if (on) {
    $("drawer").hidden = true;
    drawShow();
  } else {
    if (shown) { shown = ""; drawTab(); }
    drawBar();
  }
}

function drawShow() {
  const s = state.show;
  const cur = s.items[s.idx] || {};
  const nxt = s.items[s.idx + 1];
  const pct = s.loading || s.ended ? 0 : Math.max(0, Math.min(100, 100 * (1 - s.left / s.interval)));
  const label = s.ended ? "Finished" : s.loading ? "Putting it on the TV..." :
                s.paused ? "Paused" : "Next in " + Math.max(1, Math.ceil(s.left)) + " s";
  /* Redraw the whole view only when something shown in it changed; each
     second's tick moves the countdown and the line, and nothing else, so the
     pictures are not rebuilt under the viewer's eyes. */
  const key = [s.idx, s.ended, s.count, s.error, s.paused, s.interval, s.loading].join("|");
  if (key === shown && $("svlabel")) {
    $("svlabel").textContent = label;
    $("svfill").style.width = pct.toFixed(1) + "%";
    return;
  }
  shown = key;
  const hero = s.ended
    ? '<div class="svend"><div class="t">Slideshow finished</div>' +
      '<div class="s">The TV went back to its own input</div>' +
      '<button class="bstart" id="restart">Start over</button>' +
      '<div><span class="link" id="back">Back to the library</span></div></div>'
    : (cur.preview || cur.thumb ? '<img class="svhero" alt="" src="' +
       esc(cur.preview || cur.thumb) + '">' : "");
  $("showview").innerHTML =
    '<div class="svbody">' +
      '<div class="svprev">' +
        '<div class="svlabel">On screen</div>' +
        '<div class="svstage">' + hero + "</div>" +
        '<div class="svfoot"><div class="svname">' +
          (s.ended ? "" : '<div class="mono">' + esc(cur.title || "") + "</div>" +
                          '<div class="mono svmeta">' + esc(cur.meta || "") + "</div>") +
          (s.error ? '<div class="sverr">' + esc(s.error) + "</div>" : "") + "</div>" +
          '<div class="mono svpos">' + (s.ended ? "" : (s.idx + 1) + " / " + s.count) + "</div>" +
        "</div>" +
      "</div>" +
      '<div class="svqueue"><div class="svqhead"><span class="svlabel">Queue</span>' +
        '<span class="mono">' + s.count + (s.count === 1 ? " photo" : " photos") + "</span></div>" +
        '<div class="svlist">' + s.items.map((q, i) => {
          const now = i === s.idx && !s.ended;
          return '<div class="svrow' + (now ? " on" : "") + '" data-i="' + i + '">' +
            '<div class="svthumb" style="background:' + gradient(hue(q.title || "")) + '">' +
            (q.thumb ? '<img alt="" loading="lazy" src="' + esc(q.thumb) + '">' : "") + "</div>" +
            '<div class="svrtext"><div class="mono n">' + esc(q.title) + "</div>" +
            '<div class="mono m">' + esc(q.meta || "") + "</div></div>" +
            (now ? QUEUE_NOW : "") + "</div>";
        }).join("") + "</div>" +
      "</div>" +
    "</div>" +
    '<div class="svctl">' +
      '<div class="svbtns">' +
        '<button class="svb" id="svprev" title="Previous"' + (s.ended ? " disabled" : "") + ">" +
          PREV_ICON + "</button>" +
        '<button class="svplay" id="svtoggle" title="' + (s.paused ? "Resume" : "Pause") + '"' +
          (s.ended ? " disabled" : "") + ">" + playPauseIcon(s.paused || s.ended) + "</button>" +
        '<button class="svb" id="svnext" title="Next"' + (s.ended ? " disabled" : "") + ">" +
          NEXT_ICON + "</button>" +
      "</div>" +
      '<div class="svprog"><div class="svprogtop"><span id="svlabel">' + label + "</span>" +
        '<span class="mono">' + esc(s.ended ? "" : nxt ? nxt.title : "then the end") + "</span></div>" +
        '<div class="btrack"><div class="bfill" id="svfill" style="width:' + pct.toFixed(1) +
        '%"></div></div></div>' +
      intervals(s.interval, "data-siv") +
      (s.ended ? "" : '<button class="bbtn" id="endshow">' + STOP_ICON + "End slideshow</button>") +
    "</div>";

  $("showview").querySelectorAll(".svrow").forEach((el) => {
    el.onclick = () => showAction({ action: "goto", index: +el.dataset.i });
  });
  $("showview").querySelectorAll("[data-siv]").forEach((el) => {
    el.onclick = () => { setIv(+el.dataset.siv); showAction({ action: "interval", interval: +el.dataset.siv }); };
  });
  const on = (id, fn) => { const el = $(id); if (el) el.onclick = fn; };
  on("svprev", () => showAction({ action: "prev" }));
  on("svnext", () => showAction({ action: "next" }));
  on("svtoggle", () => showAction({ action: s.paused ? "resume" : "pause" }));
  on("endshow", () => showAction({ action: "end" }));
  on("restart", () => showAction({ action: "restart" }));
  on("back", () => showAction({ action: "dismiss" }));
}

/* --------------------------------------------------------------- the tiles */
function tile(o) {
  clicks.set(o.key, o.toggle ? { toggle: o.toggle } : { cast: o.click });
  return '<div class="tile-wrap' + (o.on ? " on" : "") + (o.dead ? " dead" : "") +
    '" data-k="' + esc(o.key) +
    '"><div class="tile">' +
    '<div class="thumb" style="background:' + gradient(o.hue) + '">' +
      (o.thumb ? '<img loading="lazy" alt="" src="' + esc(o.thumb) +
                 '" onload="this.classList.add(\'in\')" onerror="this.remove()">' : "") +
      (o.dur ? '<span class="dur mono">' + esc(o.dur) + "</span>" : "") +
      (o.warn || o.cloud ? '<div class="flags">' +
        (o.warn ? '<div class="flag">' + WARN_ICON + '<span class="mono">' + esc(o.warn) +
                  "</span></div>" : "") +
      (o.selectable ? '<div class="check">' + CHECK_ICON + "</div>" : "") +
        (o.cloud ? '<div class="flag cloud mono" title="Only in the cloud: casting it ' +
                   'downloads it first">in the cloud</div>' : "") + "</div>" : "") +
    "</div>" +
    '<div class="info"><div class="name mono" title="' + esc(o.title || o.name) + '">' + esc(o.name) +
      '</div><div class="metarow"><span class="meta mono">' + esc(o.meta) + "</span>" +
      (o.quality ? '<span class="q mono' + (o.quality === "proxy" ? " proxy" : "") +
                   '" data-q="' + esc(o.key) + '" title="Which variant to cast - click to change">' +
                   QLABEL[o.quality] + "</span>" : "") +
    "</div></div></div></div>";
}

function wireGrid(root, redraw) {
  root.querySelectorAll(".q").forEach((el) => {
    el.onclick = (e) => {
      e.stopPropagation();
      const k = el.dataset.q;
      quality[k] = QUALITY[(QUALITY.indexOf(quality[k] || "proxy") + 1) % QUALITY.length];
      redraw();
    };
  });
  root.querySelectorAll(".tile-wrap").forEach((el) => {
    el.onclick = () => {
      const what = clicks.get(el.dataset.k);
      if (!what || el.classList.contains("dead")) return;
      if (what.toggle) { what.toggle(); return; }
      if (sel.size) clearSel();
      cast(what.cast(), el);
    };
  });
}

function goproTile(it, index) {
  const video = it.kind !== "Photo";
  const q = quality[it.id] || "proxy";
  const rate = mbit(it.size, it.ms);
  /* Every row opens on the proxy: the camera original is what this TV
     refuses, and a page that offers the choice should not open on it. The
     warning is for when someone picks it anyway. */
  const refused = video && q !== "proxy" && height(it.res) > 2160;
  return tile({
    key: it.id, name: it.name, hue: hue(it.name),
    thumb: it.thumb,
    dur: video ? duration(it.ms) : "",
    warn: refused ? "TV will refuse" : "",
    meta: video ? [it.res, rate ? rate + " Mbit/s" : size(it.size)].filter(Boolean).join(" · ")
                : ["photo", size(it.size)].join(" · "),
    quality: video ? q : null,
    selectable: !video, on: !video && sel.has(it.id),
    toggle: video ? null : () => toggleSel({ source: "gopro", id: it.id, title: it.name,
                                             meta: ["photo", size(it.size)].join(" \u00b7 ") }),
    click: () => ({ source: "gopro", index: index, title: it.name,
                    quality: quality[it.id] || "proxy",
                    thumb: it.thumb,
                    meta: video ? [it.res, QLABEL[quality[it.id] || "proxy"]].filter(Boolean)
                                    .join(" \u00b7 ")
                                : "photo" }),
  });
}


function filtered(items, isPhoto) {
  if (filter === "vid") return items.filter((x) => !isPhoto(x));
  if (filter === "pho") return items.filter((x) => isPhoto(x));
  return items;
}

/* ------------------------------------------------------------------ GoPro */
function drawGopro() {
  const t = state ? state.token : null;
  const d = data.gopro;
  const [hint, cls] = tokenHint(t);
  const ask = tokenNeeded(t) || tokenOpen;
  const strip =
    '<div class="strip"><span class="mono ' + cls + '">' + esc(hint) + "</span>" +
    (t && t.listing === "rejected" && t.download !== "rejected"
      ? "<span>&mdash; the list cannot be refreshed, but what is already on it still " +
        "plays</span>" : "") +
    (ask ? '<input id="tok" class="mono" placeholder="paste gp_access_token (eyJ...)">' +
           '<button class="btn" id="savetok">Store it</button>'
         : '<span class="link" id="newtok">paste a new token</span>') +
    '<span class="grow"></span><button class="btn" id="reload"><span class="full">Reload the ' +
    'library</span><span class="short">Reload</span></button></div>';

  let body;
  if (!d) body = '<div class="empty">Loading...</div>';
  else if (d.asking) body = '<div class="empty">Asking GoPro for the library...</div>';
  else if (d.error) body = '<div class="err">' + esc(d.error) + "</div>";
  else if (d.never_listed) body = '<div class="empty">The library has never been listed on ' +
                                   "this machine &mdash; reload it.</div>";
  else {
    const rows = filtered(d.items.map((it, n) => [it, n + 1]), ([it]) => it.kind === "Photo");
    body = rows.length
      ? '<div class="grid">' + rows.map(([it, n]) => goproTile(it, n)).join("") + "</div>"
      : '<div class="empty">Nothing of that kind in the library.</div>';
  }
  $("tab-gopro").innerHTML = strip + body;

  wireGrid($("tab-gopro"), drawGopro);
  if ($("newtok")) $("newtok").onclick = () => { tokenOpen = true; drawGopro(); $("tok").focus(); };
  if ($("savetok")) $("savetok").onclick = async () => {
    const value = $("tok").value.trim();
    if (!value) return;
    $("savetok").disabled = true;
    const out = await api("/api/gopro/token", { token: value });
    if (out.error) { $("savetok").disabled = false; say(out.error, true); return; }
    tokenOpen = false;
    say("Token stored.");
    loadGopro(true);
  };
  if ($("tok")) $("tok").onkeydown = (e) => { if (e.key === "Enter") $("savetok").click(); };
  $("reload").onclick = () => loadGopro(true);
}

async function loadGopro(refresh) {
  data.gopro = refresh ? { asking: true } : null;
  drawGopro();
  data.gopro = await api("/api/gopro" + (refresh ? "?refresh=1" : ""));
  await refreshState();      // a refresh may have consumed the last of the token
  drawGopro();
}

/* --------------------------------------------------------------- OneDrive */
/* Browsed a folder at a time, as the design's breadcrumb has it: the mirror
   holds thousands of photos, most only in the cloud. Every tile takes its
   picture from the listing - the page never decides how a thumbnail is made,
   so a new source of pictures changes nothing here. */
let odPath = "";

function plural(n, one, many) { return n + " " + (n === 1 ? one : many); }

function odTile(it) {
  const photo = it.kind === "photo";
  const key = "od:" + it.path;
  const heic = !it.playable;
  return tile({
    key: key, name: it.name, title: it.path, hue: hue(it.name),
    thumb: it.thumb, cloud: it.cloud,
    warn: heic ? "HEIC \u00b7 TV cannot show it" : "",
    meta: [photo ? "photo" : "video", size(it.size), it.date].join(" \u00b7 "),
    dead: heic,
    selectable: photo && !heic, on: photo && sel.has(key),
    toggle: photo && !heic ? () => toggleSel({
      source: "onedrive", id: key, path: it.path, title: it.name,
      meta: ["OneDrive", size(it.size)].concat(it.cloud ? ["in the cloud"] : []).join(" \u00b7 ") }) : null,
    click: () => ({ source: "onedrive", path: it.path,
                    meta: it.cloud ? "OneDrive \u00b7 downloading from the cloud"
                                   : "OneDrive \u00b7 off disk" }),
  });
}

function folderTile(f) {
  const bits = [];
  if (f.folders) bits.push(plural(f.folders, "folder", "folders"));
  if (f.photos) bits.push(plural(f.photos, "photo", "photos"));
  if (f.videos) bits.push(plural(f.videos, "video", "videos"));
  return '<div class="folder" data-path="' + esc(f.path) + '">' + FOLDER_ICON +
    '<div style="min-width:0"><div class="fn">' + esc(f.name) + "</div>" +
    '<div class="fc mono">' + esc(bits.join(" \u00b7 ") || "nothing to show") + "</div></div></div>";
}

function drawOnedrive() {
  const d = data.onedrive;
  const crumbs = (d && d.crumbs) || [];
  const c = (d && d.counts) || { videos: 0, photos: 0, cloud: 0 };
  const said = [];
  if (c.videos) said.push(plural(c.videos, "video", "videos"));
  if (c.photos) said.push(plural(c.photos, "photo", "photos"));
  const count = (said.join(", ") || "no videos or photos here") +
                (c.cloud ? " \u00b7 " + c.cloud + " only in the cloud" : "");
  const trail = crumbs.map((cr, i) =>
    '<span class="crumb mono' + (i === crumbs.length - 1 ? " here" : "") + '" data-path="' +
    esc(cr.path) + '">' + esc(cr.name) + "</span>").join('<span class="crumbsep">/</span>');
  const strip =
    '<div class="strip">' + FOLDER_ICON + (trail || '<span class="mono here">' +
      esc((d && d.root) || "") + "</span>") +
    (d && !d.error ? "<span>&mdash; " + esc(count) + "</span>" : "") +
    '<span class="grow"></span>' +
    '<input id="root" class="mono" value="' + esc((d && d.root) || "") + '" hidden>' +
    '<span class="link" id="setroot">change the mirror\u2019s folder</span></div>';

  let body;
  if (!d) body = '<div class="empty">Loading...</div>';
  else if (d.error) body = '<div class="err">' + esc(d.error) + "</div>";
  else {
    const items = filtered(d.items, (x) => x.kind === "photo");
    body = (d.folders.length ? '<div class="folders">' + d.folders.map(folderTile).join("") +
                               "</div>" : "") +
      (items.length ? '<div class="grid">' + items.map(odTile).join("") + "</div>"
        : '<div class="empty">' + (d.items.length ? "Nothing of that kind in this folder."
                                                  : d.folders.length ? "Only folders here."
                                                                     : "This folder is empty.") +
          "</div>");
  }
  $("tab-onedrive").innerHTML = strip + body;

  wireGrid($("tab-onedrive"), drawOnedrive);
  $("tab-onedrive").querySelectorAll(".folder, .crumb:not(.here)").forEach((el) => {
    el.onclick = () => loadOnedrive(el.dataset.path);
  });
  $("setroot").onclick = async () => {
    const input = $("root");
    if (input.hidden) { input.hidden = false; $("setroot").textContent = "use it"; input.focus(); return; }
    await api("/api/settings", { onedrive: input.value.trim() });
    loadOnedrive("");
  };
}

async function loadOnedrive(path) {
  if (typeof path === "string") odPath = path;
  data.onedrive = null;
  drawOnedrive();
  data.onedrive = await api("/api/onedrive?path=" + encodeURIComponent(odPath));
  if (data.onedrive && typeof data.onedrive.path === "string") odPath = data.onedrive.path;
  drawTabs();
  drawOnedrive();
}

/* ---------------------------------------------------------- Google Photos */
function drawPhotos() {
  const hist = (data.photos && data.photos.history) || [];
  $("tab-photos").innerHTML =
    '<div class="panel">' +
      '<p class="note">This cannot be browsed at all: since 31 March 2025 the Library API ' +
      "only exposes items picked by hand, so the entry point is a link to one video. A " +
      "share link needs nothing; a private one needs your cookie jar.</p>" +
      '<div class="row"><input id="link" class="mono" placeholder="https://photos.app.goo.gl/...">' +
      '<button class="btn go" id="castlink">Cast</button></div>' +
      '<div class="row" style="margin-top:10px"><input id="ck" class="mono" ' +
      'placeholder="cookies.txt, for a private link (optional)"></div>' +
      '<div class="hist">' + (hist.length ? hist.map((h) =>
        '<div class="hitem"><span class="hdot"></span><span class="u mono grow">' + esc(h.link) +
        '</span><span class="w">' + esc(h.at) + '</span><button class="btn" data-again="' +
        esc(h.link) + '">Cast</button></div>').join("")
        : '<div class="empty" style="padding:14px 0">Nothing pasted yet.</div>') + "</div>" +
    "</div>";

  const go = (link, button) => cast({ source: "photos", link, cookies: $("ck").value.trim(),
                                      meta: "Google Photos link" }, button);
  $("castlink").onclick = () => go($("link").value.trim(), $("castlink"));
  $("link").onkeydown = (e) => { if (e.key === "Enter") $("castlink").click(); };
  $("tab-photos").querySelectorAll("button[data-again]").forEach((b) => {
    b.onclick = () => go(b.dataset.again, b);
  });
}

async function loadPhotos() {
  data.photos = await api("/api/photos");
  drawPhotos();
}

/* ------------------------------------------------------------------ wiring */
function drawTab() {
  if (tab === "gopro") drawGopro();
  if (tab === "onedrive") drawOnedrive();
  if (tab === "photos") drawPhotos();
}

/* Switching tabs leaves a running cast alone. The design canvas drops it,
   which suits a mock-up; a real cast should not die because someone browses. */
function showTab(name) {
  tab = name;
  ["gopro", "onedrive", "photos"].forEach((n) => { $("tab-" + n).hidden = n !== tab; });
  drawTabs();
  if (tab === "gopro" && !data.gopro) loadGopro(false);
  else if (tab === "onedrive" && !data.onedrive) loadOnedrive("");
  else if (tab === "photos" && !data.photos) loadPhotos();
  else drawTab();
}

$("tvchip").onclick = async () => {
  $("tvchip").innerHTML = '<span class="dot off"></span><span class="tvn">Looking...</span>';
  const out = await api("/api/tv", {});
  if (!out.found || !out.found.length) {
    await refreshState();
    say("No DLNA renderer answered. Switch the TV on and try again, or name " +
        "it with cast-ui -t <address>.", true);
    return;
  }
  const pick = out.found[0];
  await api("/api/settings", { tv: pick.ip, tv_name: pick.name });
  await refreshState();
  say("Found " + pick.name + " at " + pick.ip + ", and remembered it.");
};

setInterval(() => {
  if (!busy && state && ((state.cast && state.cast.running) ||
                         (state.show && state.show.active))) refreshState();
}, 1000);

refreshState().then(() => { loadGopro(false); api("/api/onedrive").then((d) => { data.onedrive = d; drawTabs(); }); });
</script>
</body>
</html>
"""


# ---------------------------------------------------------------------- http
class UI(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype):
        raw = body.encode("utf-8")
        self.answered = True
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        try:
            self.wfile.write(raw)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def _send_bytes(self, code, body, ctype, cache):
        self.answered = True
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", cache)
        self.end_headers()
        try:
            self.wfile.write(body)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def _json(self, data, code=200):
        self._send(code, json.dumps(data), "application/json; charset=utf-8")

    def _body(self):
        try:
            length = int(self.headers.get("Content-Length") or 0)
            return json.loads(self.rfile.read(length) or b"{}")
        except (ValueError, OSError):
            return {}

    def _guard(self, work):
        """A helper that fails must not take the answer down with it.

        Everything here leans on other commands - a discovery that times out,
        a token that has gone stale - and a page left waiting on a dropped
        connection says nothing at all. A sentence in the JSON does.
        """
        self.answered = False
        try:
            work()
        except subprocess.TimeoutExpired as e:
            name = os.path.basename((e.cmd or ["a command"])[0])
            if not self.answered:
                self._json({"error": "%s took too long to answer." % name})
        except Exception as e:
            if not self.answered:
                self._json({"error": "%s: %s" % (type(e).__name__, e)})
            else:
                self.close_connection = True

    def do_GET(self):
        self._guard(self._get)

    def do_POST(self):
        self._guard(self._post)

    def _get(self):
        path, _, query = self.path.partition("?")
        if path in ("/", "/index.html"):
            self._send(200, PAGE, "text/html; charset=utf-8")
        elif path == "/api/state":
            self._json({"tv": tv_address(), "tv_name": config().get("tv_name"),
                        "token": token_state(), "cast": Cast.state(),
                        "show": Show.state()})
        elif path.startswith("/api/thumb/"):
            provider = PROVIDERS.get(path[len("/api/thumb/"):])
            key = urllib.parse.parse_qs(query).get("k", [""])[0]
            got = provider.serve(key) if provider and key else None
            if got and got[0] == "redirect":
                # the browser fetches the picture from where it lives; nothing
                # of it passes through here
                self.answered = True
                self.send_response(302)
                self.send_header("Location", got[1])
                self.send_header("Cache-Control", "private, max-age=900")
                self.send_header("Content-Length", "0")
                self.end_headers()
            elif got:
                self._send_bytes(200, got[1], got[2], "private, max-age=86400")
            else:
                self._send(404, "", "text/plain")
        elif path == "/api/onedrive/file":
            # the whole photo, for the slideshow's preview - never a cloud-only
            # one, which reading would fetch
            full = onedrive_file(urllib.parse.parse_qs(query).get("k", [""])[0])
            if (full and full.lower().endswith(PHOTO_EXT)
                    and not in_cloud_only(os.stat(full))):
                with open(full, "rb") as fh:
                    body = fh.read()
                self._send_bytes(200, body, "image/png" if full.lower().endswith(".png")
                                 else "image/jpeg", "private, max-age=3600")
            else:
                self._send(404, "", "text/plain")
        elif path == "/api/gopro":
            self._json(gopro_items(refresh="refresh=1" in query))
        elif path == "/api/onedrive":
            self._json(onedrive_folder(urllib.parse.parse_qs(query).get("path", [""])[0]))
        elif path == "/api/photos":
            self._json({"history": photos_history()})
        else:
            self._json({"error": "no such thing here"}, 404)

    def _post(self):
        req = self._body()
        if self.path == "/api/cast":
            cmd, title, problem = cast_command(req)
            # the bar shows the tile that was clicked; only our own thumbnail
            # route is accepted, since it ends up in an <img src>
            thumb = req.get("thumb")
            if not (isinstance(thumb, str) and thumb.startswith("/api/thumb/")):
                thumb = None
            meta = req.get("meta") if isinstance(req.get("meta"), str) else None
            self._json({"error": problem} if problem
                       else Cast.start(cmd, title, thumb=thumb, meta=(meta or "")[:120]))
        elif self.path == "/api/show":
            action = req.get("action")
            if action == "start":
                items = show_items(req.get("items"))
                interval = req.get("interval") if req.get("interval") in (3, 5, 8, 12) else 5
                self._json(Show.start(items, interval) if items
                           else {"error": "No photos from the library to show."})
            elif action == "restart":
                self._json(Show.start(list(Show.items), Show.interval) if Show.items
                           else {"error": "Nothing to start over."})
            elif action == "end":
                self._json(Show.end())
            elif action == "dismiss":
                self._json(Show.dismiss())
            else:
                self._json(Show.control(action, req.get("index"), req.get("interval")))
        elif self.path == "/api/stop":
            self._json(Cast.stop())
        elif self.path == "/api/gopro/token":
            value = (req.get("token") or "").strip()
            if not value:
                self._json({"error": "Nothing pasted."})
                return
            # cast-gopro owns the token file, including the paste-twice repair
            done = subprocess.run(cc.sibling("cast-gopro") + ["--token", value],
                                  capture_output=True, text=True, timeout=30)
            self._json({"error": (done.stderr or "").strip()} if done.returncode
                       else {"stored": True, "token": token_state()})
        elif self.path == "/api/settings":
            saved = config_set(tv=req.get("tv"), tv_name=req.get("tv_name"),
                               onedrive=req.get("onedrive"))
            self._json({"tv": saved.get("tv"), "onedrive": onedrive_root()})
        elif self.path == "/api/tv":
            self._json({"found": renderers()})
        else:
            self._json({"error": "no such thing here"}, 404)


class Server(socketserver.ThreadingTCPServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    ap = argparse.ArgumentParser(
        description="A local page for choosing what to cast.")
    ap.add_argument("-p", "--port", type=int, default=8896,
                    help="port to serve the page on (cast-tv itself uses 8895)")
    ap.add_argument("-b", "--bind", default="127.0.0.1",
                    help="address to listen on; anything else exposes the page "
                         "to the network, and the page can start a cast")
    ap.add_argument("--onedrive", help="folder holding the mirrored account")
    ap.add_argument("-t", "--tv", help="TV address, remembered for next time")
    ap.add_argument("--no-open", dest="open_it", action="store_false",
                    help="do not open a browser")
    args = ap.parse_args()

    if args.onedrive or args.tv:
        config_set(onedrive=args.onedrive, tv=args.tv)
    if tv_address() and not config().get("tv_name"):
        threading.Thread(target=remember_tv_name, daemon=True).start()

    try:
        srv = Server((args.bind, args.port), UI)
    except OSError as e:
        print("Cannot bind %s:%d: %s" % (args.bind, args.port, e))
        return 1

    where = "http://%s:%d/" % ("localhost" if args.bind == "127.0.0.1"
                               else args.bind, args.port)
    print("cast-ui on %s" % where)
    if args.bind != "127.0.0.1":
        print("  ! reachable from the network, and anyone opening it can cast")
    print("  TV: %s" % (tv_address() or "not chosen yet - use \"Find the TV\""))
    print("  OneDrive: %s" % onedrive_root())
    print("  Ctrl+C ends it")
    if args.open_it:
        threading.Thread(target=webbrowser.open, args=(where,), daemon=True).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nStopping.")
        Cast.stop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
