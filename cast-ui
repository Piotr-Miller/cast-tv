HERE = os.path.dirname(os.path.realpath(__file__))
UI_CONFIG = os.path.join(cc.CONFIG, "ui.json")
GOPRO_TOKEN = os.path.join(cc.CONFIG, "gopro-token")
PHOTOS_HISTORY = os.path.join(cc.CONFIG, "photos-history.json")
ONEDRIVE_DEFAULT = os.path.expanduser("~/.onedrive-sync")
VIDEO_EXT = (".mp4", ".m4v", ".mov", ".mkv", ".avi", ".ts", ".m2ts", ".webm",
             ".mpg", ".mpeg", ".wmv")
PHOTO_EXT = (".jpg", ".jpeg", ".png")        # what the TV decodes as a still
STILL_EXT = PHOTO_EXT + (".heic",)           # what is listed as a photo
LIST_COUNT = 60          # one API page is more than enough to pick from


def config():
    try:
        with open(UI_CONFIG) as fh:
            return json.load(fh)
    except Exception:
        return {}


def config_set(**kv):
    data = config()
    data.update({k: v for k, v in kv.items() if v is not None})
    os.makedirs(cc.CONFIG, exist_ok=True)
    with open(UI_CONFIG, "w") as fh:
        json.dump(data, fh, indent=1)
    return data


def tv_address():
    return config().get("tv") or os.environ.get("CAST_TV") or None


def onedrive_root():
    return config().get("onedrive") or ONEDRIVE_DEFAULT


# ------------------------------------------------------------------- sources
class Gopro:
    """How GoPro answered last time, because the token itself will not say.

    Two answers, not one: a token GoPro has stopped accepting for the library
    listing (/media/search, 401) went on being accepted for /download - the
    pictures and the streams of items already listed - a day after it was
    stored. So "rejected" for one says nothing about the other.
    """
    listing = None          # /media/search: None, "ok", "rejected" or "failed"
    download = None         # /media/{id}/download: None, "ok" or "rejected"
    module = None           # cast-gopro, loaded once for the thumbnail calls
    thumbs = {}             # media id -> (signed url, when it was fetched)
    THUMB_TTL = 20 * 60     # the addresses are signed; how long for is not said


def gopro_module():
    """cast-gopro as a module. A thumbnail is one API call, and spawning a
    process per row would cost more than the call itself - sixty of them for
    one screen of the library."""
    if Gopro.module is None:
        path = os.path.join(HERE, "cast-gopro")
        loader = importlib.machinery.SourceFileLoader("cast_gopro", path)
        spec = importlib.util.spec_from_loader("cast_gopro", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        Gopro.module = mod
    return Gopro.module


def gopro_thumb(media_id):
    """A signed address for a row's picture, or None.

    /media/{id}/thumbnail answers 406 to every Accept header tried and the
    sprites list is empty, but a video carries a "large" label that /download
    only returns when asked for by name: a 1280 px jpg. A photo has no such
    label, and its only still is the source itself.
    """
    hit = Gopro.thumbs.get(media_id)
    if hit and time.time() - hit[1] < Gopro.THUMB_TTL:
        return hit[0]
    if Gopro.download == "rejected":
        return None         # sixty rows would mean sixty 401s
    items = cc.cache_read("gopro-list.json") or []
    item = next((i for i in items if i.get("id") == media_id), None)
    if item is None:
        return None         # only rows of our own listing, never an arbitrary id
    g = gopro_module()
    photo = item.get("kind") == "Photo"
    said = io.StringIO()
    try:
        # cast-gopro reports trouble by printing and exiting; keep it quiet
        with contextlib.redirect_stderr(said):
            data = g.api("/media/%s/download" % media_id, g.token(),
                         params=None if photo else "labels=large")
    except SystemExit:
        if "401" in said.getvalue():
            Gopro.download = "rejected"
        return None
    Gopro.download = "ok"
    wanted = ("source",) if photo else ("large",)
    for var in data.get("_embedded", {}).get("variations", []) or []:
        if var.get("label") in wanted and var.get("url"):
            Gopro.thumbs[media_id] = (var["url"], time.time())
            return var["url"]
    return None


# ---------------------------------------------------------------- thumbnails
class ThumbProvider:
    """One way of getting a small picture for an item.

    The page never builds a thumbnail address. Every listing hands each item its
    `thumb` - or None, and the tile keeps its gradient - taken from the first
    provider registered for that source which says it can serve it. `can` has
    to be cheap: it runs for every item of a folder before anyone looks, so it
    may consult what the listing already knows and nothing more. `serve` does
    the work, and only when the browser asks for the picture.
    """
    name = ""

    def can(self, item):
        return False

    def key(self, item):
        return ""

    def serve(self, key):
        """("redirect", url), ("image", bytes, content type), or None."""
        return None


class GoproStills(ThumbProvider):
    """GoPro's own stills: a video's "large" label, a photo's source."""
    name = "gopro"

    def can(self, item):
        return bool(item.get("id"))

    def key(self, item):
        return item["id"]

    def serve(self, key):
        if not re.match(r"^[0-9a-f]{16,40}$", key):
            return None
        url = gopro_thumb(key)
        return ("redirect", url) if url else None


class ExifPreviews(ThumbProvider):
    """The preview a camera or phone embeds in a JPEG's EXIF header, read from
    the first 128 KB of the file rather than the whole of it - the photos in the
    mirror average about 12 MB.

    A placeholder whose bytes are only in the cloud is refused outright: reading
    even its head makes Windows fetch the whole file. That refusal is exactly the
    gap a Microsoft Graph provider would fill - registered after this one for
    "onedrive", it would take the items this one turns down, and no view would
    need to change.
    """
    name = "exif"
    HEAD = 128 * 1024
    cache = {}              # (path, mtime) -> (bytes, content type)

    def can(self, item):
        return (item.get("kind") == "photo" and not item.get("cloud")
                and item.get("name", "").lower().endswith((".jpg", ".jpeg")))

    def key(self, item):
        return item["path"]

    def serve(self, key):
        full = onedrive_file(key)
        if not full:
            return None
        try:
            st = os.stat(full)
        except OSError:
            return None
        if in_cloud_only(st):
            return None     # asked for directly: still never read
        hit = self.cache.get((full, st.st_mtime))
        if hit:
            return ("image",) + hit
        try:
            with open(full, "rb") as fh:
                found = exif_thumbnail(fh.read(self.HEAD))
        except OSError:
            return None
        if not found:
            return None
        body, ctype = upright(*found)
        if len(self.cache) > 800:
            self.cache.clear()
        self.cache[(full, st.st_mtime)] = (body, ctype)
        return ("image", body, ctype)


# The order is the policy: the first provider for a source that can serve an
# item serves it. A Graph provider for cloud-only files goes after ExifPreviews.
THUMBNAILS = {"gopro": [GoproStills()], "onedrive": [ExifPreviews()]}
PROVIDERS = {p.name: p for chain in THUMBNAILS.values() for p in chain}


def thumb_for(source, item, version=""):
    """The address of an item's picture, or None - the only place one is built."""
    for provider in THUMBNAILS.get(source, []):
        if provider.can(item):
            return "/api/thumb/%s?k=%s%s" % (
                provider.name, urllib.parse.quote(provider.key(item), safe=""),
                "&v=" + version if version else "")
    return None


def exif_thumbnail(head):
    """(jpeg bytes, orientation) from the EXIF block in the head of a JPEG, or None."""
    if head[:2] != b"\xff\xd8":
        return None
    i = 2
    while i + 4 <= len(head):
        if head[i] != 0xFF:
            return None
        marker = head[i + 1]
        if marker in (0xD9, 0xDA):      # end of image, start of scan: no EXIF ahead
            return None
        size = int.from_bytes(head[i + 2:i + 4], "big")
        if marker == 0xE1 and head[i + 4:i + 10] == b"Exif\x00\x00":
            return _thumb_in_tiff(head[i + 10:i + 2 + size])
        i += 2 + size
    return None


def _thumb_in_tiff(t):
    order = {b"II": "little", b"MM": "big"}.get(t[:2])
    if not order or len(t) < 8:
        return None

    def u16(o):
        return int.from_bytes(t[o:o + 2], order)

    def u32(o):
        return int.from_bytes(t[o:o + 4], order)

    def ifd(off):
        if off <= 0 or off + 2 > len(t):
            return {}, 0
        n = u16(off)
        tags = {}
        for k in range(n):
            e = off + 2 + 12 * k
            if e + 12 > len(t):
                break
            tag, kind, count = u16(e), u16(e + 2), u32(e + 4)
            tags[tag] = u16(e + 8) if kind == 3 and count == 1 else u32(e + 8)
        after = off + 2 + 12 * n
        return tags, (u32(after) if after + 4 <= len(t) else 0)

    ifd0, next_off = ifd(u32(4))
    ifd1, _ = ifd(next_off)
    start, length = ifd1.get(0x0201), ifd1.get(0x0202)
    if not start or not length or start + length > len(t):
        return None
    jpeg = t[start:start + length]
    if jpeg[:2] != b"\xff\xd8":
        return None
    return jpeg, ifd0.get(0x0112, 1)


def jpeg_size(jpeg):
    """(width, height) from a JPEG's frame header, or (0, 0)."""
    i = 2
    while i + 9 <= len(jpeg):
        if jpeg[i] != 0xFF:
            return 0, 0
        marker = jpeg[i + 1]
        if 0xC0 <= marker <= 0xC3:
            return (int.from_bytes(jpeg[i + 7:i + 9], "big"),
                    int.from_bytes(jpeg[i + 5:i + 7], "big"))
        i += 2 + int.from_bytes(jpeg[i + 2:i + 4], "big")
    return 0, 0


def upright(jpeg, orientation):
    """The preview the right way up. EXIF previews are stored as the sensor saw
    them, and the orientation tag belongs to the photo, not the preview, so a
    portrait shot's preview lies on its side. Turning JPEG pixels needs a
    decoder; wrapping the preview in an SVG that turns it needs none."""
    if orientation not in (3, 6, 8):
        return jpeg, "image/jpeg"
    w, h = jpeg_size(jpeg)
    if not w or not h:
        return jpeg, "image/jpeg"
    if orientation == 3:
        size, turn = (w, h), "translate(%d %d) rotate(180)" % (w, h)
    elif orientation == 6:
        size, turn = (h, w), "translate(%d 0) rotate(90)" % h
    else:
        size, turn = (h, w), "translate(0 %d) rotate(-90)" % w
    data = "data:image/jpeg;base64," + base64.b64encode(jpeg).decode()
    svg = ('<svg xmlns="http://www.w3.org/2000/svg" '
           'xmlns:xlink="http://www.w3.org/1999/xlink" width="%d" height="%d" '
           'viewBox="0 0 %d %d"><image width="%d" height="%d" transform="%s" '
           'href="%s" xlink:href="%s"/></svg>'
           % (size[0], size[1], size[0], size[1], w, h, turn, data, data))
    return svg.encode(), "image/svg+xml"


def token_state():
    """What can honestly be said about the stored GoPro token.

    This began by reading the expiry out of the payload, on the assumption that
    the token is a JWT. A real one is not: it arrives as a JWE - five parts, a
    header naming alg and enc, and a payload that is encrypted - so no expiry
    can be read from it at all, and a token of my own making was the only thing
    that assumption ever worked on.

    What is knowable without spending a call: whether one is stored, how long
    ago (they last a few hours), and how GoPro answered the last time it was
    used. The JWT path stays for a token that does carry a readable expiry.
    """
    try:
        with open(GOPRO_TOKEN) as fh:
            raw = fh.read().strip()
        # never negative: the clock can move behind the file's timestamp, and
        # "stored -115m ago" is worse than saying nothing useful
        age = max(0, int(time.time() - os.path.getmtime(GOPRO_TOKEN)))
    except OSError:
        return {"state": "missing"}
    if not raw:
        return {"state": "missing"}
    parts = raw.split(".")
    if len(parts) == 3:
        try:
            pad = "=" * (-len(parts[1]) % 4)
            claims = json.loads(base64.urlsafe_b64decode(parts[1] + pad))
            exp = claims.get("exp")
            if isinstance(exp, (int, float)):
                left = int(exp - time.time())
                return {"state": "valid" if left > 0 else "expired",
                        "left": left, "age": age}
        except (ValueError, binascii.Error, UnicodeDecodeError):
            pass
    return {"state": "opaque", "age": age, "listing": Gopro.listing,
            "download": Gopro.download}


def gopro_items(refresh=False):
    """The cloud library. cast-gopro caches its own listing, so we reuse that."""
    if refresh:
        done = subprocess.run(cc.sibling("cast-gopro") + ["-n", str(LIST_COUNT)],
                              capture_output=True, text=True, timeout=180)
        if done.returncode != 0:
            # the token expiring is the common case, and it explains itself
            said = (done.stderr or done.stdout).strip()
            Gopro.listing = "rejected" if "401" in said else "failed"
            return {"error": said or "cast-gopro failed without saying why"}
        Gopro.listing = "ok"
    items = cc.cache_read("gopro-list.json")
    if items is None:
        return {"items": [], "never_listed": True}
    return {"items": [dict(i, thumb=thumb_for("gopro", i)) for i in items]}


# OneDrive on Windows keeps files it has not downloaded as placeholders with
# these attributes; reading one makes Windows fetch it from the cloud first
CLOUD_ONLY = 0x00400000 | 0x00040000 | 0x00001000  # recall on access/open, offline


def in_cloud_only(st):
    """True for a placeholder whose bytes are still in the cloud. Casting one is
    fine - it is chosen, and has to arrive anyway - but anything read casually,
    a thumbnail for instance, would pull the whole file down. The Linux mirror
    is a plain download, so there is no such attribute there."""
    return bool(getattr(st, "st_file_attributes", 0) & CLOUD_ONLY)


def onedrive_file(rel):
    """The full path of a file inside the mirror, or None. Everything the page
    names in OneDrive comes through here: a page open in a browser must not be
    able to reach past the mirror."""
    if not isinstance(rel, str):
        return None
    root = os.path.realpath(onedrive_root())
    full = os.path.realpath(os.path.join(root, os.path.expanduser(rel)))
    if not full.startswith(root + os.sep) or not os.path.isfile(full):
        return None
    return full


def media_kind(name):
    low = name.lower()
    if low.endswith(VIDEO_EXT):
        return "video"
    if low.endswith(STILL_EXT):
        return "photo"
    return None


def shallow_counts(path):
    """What a folder holds one level down - enough for its tile, without
    walking a mirror of thousands of files every time a folder opens."""
    videos = photos = folders = 0
    try:
        with os.scandir(path) as entries:
            for e in entries:
                if e.name.startswith("."):
                    continue
                if e.is_dir(follow_symlinks=False):
                    folders += 1
                else:
                    kind = media_kind(e.name)
                    videos += kind == "video"
                    photos += kind == "photo"
    except OSError:
        pass
    return {"videos": videos, "photos": photos, "folders": folders}


def onedrive_folder(rel=""):
    """One folder of the mirror: its subfolders, and the videos and photos in it.

    The mirror holds thousands of photos, most of them only in the cloud, so it
    is browsed a folder at a time, as the design's breadcrumb has it, rather
    than walked whole. Nothing here reads a file's contents: size, date and
    whether it is a cloud-only placeholder all come with the directory entry.
    """
    root = onedrive_root()
    if not os.path.isdir(root):
        return {"root": root,
                "error": "%s is not a directory - the OneDrive mirror lives "
                         "somewhere else, or is not set up yet." % root}
    base = os.path.realpath(root)
    here = os.path.realpath(os.path.join(base, rel or ""))
    if here != base and not here.startswith(base + os.sep):
        here = base
    if not os.path.isdir(here):
        return {"root": root, "error": "No such folder in the mirror: %s" % rel}
    rel = "" if here == base else os.path.relpath(here, base)

    folders, items = [], []
    with os.scandir(here) as entries:
        for e in entries:
            if e.name.startswith("."):
                continue
            path = os.path.join(rel, e.name) if rel else e.name
            if e.is_dir(follow_symlinks=False):
                folders.append(dict({"name": e.name, "path": path}, **shallow_counts(e.path)))
                continue
            kind = media_kind(e.name)
            if not kind:
                continue
            try:
                st = e.stat()
            except OSError:
                continue
            item = {"name": e.name, "path": path, "kind": kind, "size": st.st_size,
                    "cloud": in_cloud_only(st),
                    # HEIC is listed, since it is there, but the TV cannot decode
                    # it and there is nothing here that converts it
                    "playable": not e.name.lower().endswith(".heic"),
                    "date": time.strftime("%Y-%m-%d", time.localtime(st.st_mtime))}
            item["thumb"] = thumb_for("onedrive", item, str(int(st.st_mtime)))
            items.append(item)
    folders.sort(key=lambda f: f["name"].lower())
    items.sort(key=lambda i: i["name"].lower())
    crumbs = [{"name": os.path.basename(base.rstrip(os.sep)) or base, "path": ""}]
    walked = ""
    for part in (rel.split(os.sep) if rel else []):
        walked = os.path.join(walked, part) if walked else part
        crumbs.append({"name": part, "path": walked})
    return {"root": root, "path": rel, "crumbs": crumbs, "folders": folders,
            "items": items,
            "counts": {"videos": sum(i["kind"] == "video" for i in items),
                       "photos": sum(i["kind"] == "photo" for i in items),
                       "cloud": sum(1 for i in items if i["cloud"])}}


def photos_history():
    try:
        with open(PHOTOS_HISTORY) as fh:
            return json.load(fh)
    except Exception:
        return []


def photos_remember(link):
    """With no library to browse, the links pasted so far are the library."""
    hist = [h for h in photos_history() if h.get("link") != link]
    hist.insert(0, {"link": link, "at": time.strftime("%Y-%m-%d %H:%M")})
    hist = hist[:40]
    os.makedirs(cc.CONFIG, exist_ok=True)
    with open(PHOTOS_HISTORY, "w") as fh:
        json.dump(hist, fh, indent=1)
    return hist


def remember_tv_name():
    """The header shows the TV by name, as the design does; an address given
    with -t comes without one, so ask the device description once."""
    ip = tv_address()
    for port, path in ((9197, "/dmr"), (7676, "/dmr"), (52235, "/dmr")):
        try:
            with urllib.request.urlopen("http://%s:%d%s" % (ip, port, path),
                                        timeout=3) as r:
                xml = r.read().decode("utf-8", "replace")
        except Exception:
            continue
        m = re.search(r"<friendlyName>(.*?)</friendlyName>", xml, re.S)
        if m:
            config_set(tv_name=html.unescape(m.group(1)).strip())
            return


def renderers():
    """Whatever answers SSDP, via the discovery cast-tv already does."""
    done = subprocess.run(cc.sibling("cast-tv") + ["--list"], capture_output=True,
                          text=True, timeout=40)
    out = []
    for line in done.stdout.splitlines():
        ip, _, name = line.strip().partition(" ")
        if re.match(r"^\d+\.\d+\.\d+\.\d+$", ip):
            out.append({"ip": ip, "name": name.strip() or ip})
    return out


# ------------------------------------------------------------------- casting
# cast-tv redraws "PLAYING      0:00:07.451 / 0:00:09" every two seconds; the
# last such line is the TV's own word on where it is
STATUS = re.compile(r"^(PLAYING|PAUSED_PLAYBACK|TRANSITIONING|STOPPED|"
                    r"NO_MEDIA_PRESENT)\s+(\S+)\s*/\s*(\S+)")
# lines the commands print when a cast will not happen; the first one found
# is what the bar says, since it is usually the whole reason
FAILURES = ("never started playing", "rejected the request", "could not reach",
            "does not expose AVTransport", "No DLNA renderer answered",
            "rejected the token", "No stream found", "No media found",
            "serves no video", "No download address", "Cannot bind",
            "No such file", "Could not run")


def seconds(stamp):
    """0:00:07.451 -> 7; anything unparseable, such as "-", -> 0."""
    try:
        parts = [float(p) for p in stamp.split(":")]
    except ValueError:
        return 0
    total = 0
    for p in parts:
        total = total * 60 + p
    return int(total)


class Cast:
    """The one running cast. The TV plays one thing, so one child at a time."""
    lock = threading.Lock()
    proc = None
    title = None
    command = None
    log = deque(maxlen=60)
    started = 0
    stopped = False     # ended by Stop, which is not a failure whatever it exits with
    thumb = None        # what the tile showed, so the bar can show it too
    meta = None

    @classmethod
    def state(cls):
        proc = cls.proc
        running = proc is not None and proc.poll() is None
        lines = list(cls.log)
        tv, position, duration = None, 0, 0
        for line in reversed(lines):
            m = STATUS.match(line.strip())
            if m:
                tv, position, duration = m.group(1), seconds(m.group(2)), seconds(m.group(3))
                break
        reason = next((line.strip() for line in lines
                       if any(f in line for f in FAILURES)), None)
        if proc is None:
            outcome = None
        elif running:
            outcome = "running"
        elif cls.stopped:
            outcome = "stopped"
        elif reason or proc.returncode:
            outcome = "failed"
        else:
            outcome = "finished"
        return {"running": running, "title": cls.title, "command": cls.command,
                "exit": None if running or proc is None else proc.returncode,
                "log": lines, "outcome": outcome, "reason": reason,
                "tv_state": tv, "position": position, "duration": duration,
                "resolving": running and tv is None and any(
                    line.startswith("Resolving") for line in lines),
                "thumb": cls.thumb, "meta": cls.meta,
                "seconds": int(time.time() - cls.started) if cls.started else 0}

    @classmethod
    def start(cls, cmd, title, thumb=None, meta=None):
        Show.end(quiet=True)    # the TV plays one thing, and both want the port
        with cls.lock:
            if cls.proc is not None and cls.proc.poll() is None:
                return {"error": "Something is already playing - stop that first."}
            # without this the child's prints sit in a pipe buffer and the page
            # shows nothing until the cast is over
            env = dict(os.environ, PYTHONUNBUFFERED="1")
            # A GoPro or Photos cast is two processes deep, because the resolver
            # runs cast-tv itself. Signalling the one pid we hold would leave
            # cast-tv behind, still serving and still playing, so the child gets
            # its own group and Stop signals the group.
            group = ({"creationflags": subprocess.CREATE_NEW_PROCESS_GROUP}
                     if os.name == "nt" else {"start_new_session": True})
            try:
                cls.proc = subprocess.Popen(
                    cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                    env=env, cwd=HERE, **group)
            except OSError as e:
                return {"error": "Could not run this:\n%s\n%s"
                                 % (" ".join(cmd), e)}
            cls.title, cls.command = title, " ".join(cmd)
            cls.thumb, cls.meta, cls.stopped = thumb, meta, False
            cls.started = time.time()
            cls.log.clear()
            threading.Thread(target=cls._read, args=(cls.proc,), daemon=True).start()
        return cls.state()

    @classmethod
    def _read(cls, proc):
        r"""cast-tv redraws its status line with \r, so a line can end either way."""
        buf = b""
        while True:
            # read1, not read: on a buffered pipe read(256) waits until it has
            # all 256 bytes, and at one 40-byte status line every two seconds
            # the log reached the page in bursts some twelve seconds apart -
            # a nine-second clip could play from start to end inside one wait
            chunk = proc.stdout.read1(4096)
            if not chunk:
                break
            buf += chunk
            parts = re.split(rb"[\r\n]", buf)
            buf = parts.pop()
            for part in parts:
                text = part.decode("utf-8", "replace").rstrip()
                if text:
                    cls.log.append(text)
        if buf.strip():
            cls.log.append(buf.decode("utf-8", "replace").rstrip())
        proc.wait()
        cls.log.append("-- the command exited (%d)" % proc.returncode)

    @classmethod
    def stop(cls):
        with cls.lock:
            proc = cls.proc
            if proc is None or proc.poll() is not None:
                return cls.state()
            cls.stopped = True
            told_the_tv = False
            if os.name == "posix":
                # cast-tv stops the TV on Ctrl+C, and every process in the
                # group gets this, so the whole cast unwinds by itself
                try:
                    os.killpg(os.getpgid(proc.pid), signal.SIGINT)
                    proc.wait(timeout=8)
                    told_the_tv = True
                except (subprocess.TimeoutExpired, OSError):
                    pass
            else:
                # CTRL_BREAK does clear the group, but Windows kills the
                # processes outright (0xC000013A) rather than raising
                # KeyboardInterrupt, so nothing gets the chance to tell the TV
                try:
                    proc.send_signal(signal.CTRL_BREAK_EVENT)
                    proc.wait(timeout=8)
                except (subprocess.TimeoutExpired, OSError, ValueError):
                    pass
            if proc.poll() is None:
                proc.terminate()
                try:
                    proc.wait(timeout=4)
                except subprocess.TimeoutExpired:
                    proc.kill()
            if not told_the_tv:
                cls.log.append("-- asking the TV to stop as well")
                # naming the TV skips a second round of discovery
                stop = cc.sibling("cast-tv") + ["--stop"]
                tv = tv_address()
                try:
                    subprocess.run(stop + (["-t", tv] if tv else []),
                                   capture_output=True, text=True, timeout=60)
                except (OSError, subprocess.TimeoutExpired) as e:
                    cls.log.append("-- could not reach the TV to stop it: %s" % e)
        return cls.state()


# ----------------------------------------------------------------- slideshow
def casttv_module():
    """cast-tv as a module. A slideshow keeps one server up for its whole length
    and only changes what the TV is pointed at - a process per picture would
    mean a new server, and a new wait, for every slide."""
    if not hasattr(casttv_module, "mod"):
        path = os.path.join(HERE, "cast-tv")
        loader = importlib.machinery.SourceFileLoader("cast_tv", path)
        spec = importlib.util.spec_from_loader("cast_tv", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        casttv_module.mod = mod
    return casttv_module.mod


class Show:
    """A slideshow the laptop drives, as the design has it: DLNA has no
    playlist, so the queue and the countdown live here, and the TV is simply
    pointed at the next picture when its time comes.

    Measured on the QE83S85F: over a still that is showing, SetAVTransportURI
    alone starts the next one - TRANSITIONING, then PLAYING about a second
    later - and Play is then refused with UPnP 701, "Transition not
    available". So Play goes only to a TV that has stopped. A still left alone
    stayed up for the thirty seconds it was watched, so nothing is kept alive.
    """
    lock = threading.RLock()
    wake = threading.Event()
    generation = 0          # bumped by every start and end; an old loop sees it and quits
    items = []              # [{source, id, title, thumb, meta}]
    urls = {}               # index -> resolved upstream address
    idx = 0
    want = None             # an index asked for by prev / next / a queue click
    interval = 5
    paused = False
    paused_left = 0.0
    shown_at = 0.0
    loading = False
    active = False
    ended = False
    error = None
    server = None
    avt = None
    base = None
    PORT = 8895             # cast-tv's own; a slideshow and a cast never run together

    @classmethod
    def state(cls):
        with cls.lock:
            if cls.paused:
                left = cls.paused_left
            elif cls.loading or not cls.active:
                left = float(cls.interval)
            else:
                left = max(0.0, cls.shown_at + cls.interval - time.time())
            return {"active": cls.active, "ended": cls.ended, "idx": cls.idx,
                    "count": len(cls.items), "interval": cls.interval,
                    "paused": cls.paused, "loading": cls.loading,
                    "left": round(left, 1), "error": cls.error,
                    "items": [{k: it.get(k) for k in ("title", "thumb", "preview", "meta")}
                              for it in cls.items]}

    @classmethod
    def resolve(cls, i):
        """Where picture i comes from - ("file", path) off disk, or ("url",
        address) upstream - found once and kept for the show."""
        if i in cls.urls or not 0 <= i < len(cls.items):
            return cls.urls.get(i)
        item = cls.items[i]
        if item["source"] == "onedrive":
            cls.urls[i] = ("file", item["full"])
            return cls.urls[i]
        g = gopro_module()
        said = io.StringIO()
        try:
            with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(said):
                url = g.library_url(item["id"], g.token(), "auto")
        except SystemExit:
            raise RuntimeError(said.getvalue().strip().split("\n")[0] or
                               "GoPro would not hand over %s" % item["title"])
        cls.urls[i] = ("url", url)
        return cls.urls[i]

    @classmethod
    def put(cls, gen, i):
        """Point the TV at picture i."""
        ct = casttv_module()
        with cls.lock:
            if gen != cls.generation:
                return
            cls.loading, cls.idx = True, i
        try:
            kind, where = cls.resolve(i)
            ext = os.path.splitext(where if kind == "file" else
                                   urllib.parse.urlparse(where).path)[1].lower()
            # fresh per picture, per show; the extension gives the TV its type
            path = "/still/%d-%d%s" % (gen, i, ext if ext in PHOTO_EXT else ".jpg")
            if kind == "file":
                ct.RangeHandler.files[path] = where
            else:
                ct.RangeHandler.remote[path] = where
            url = cls.base + path
            ct.soap(cls.avt, ct.AVT, "SetAVTransportURI",
                    "<CurrentURI>%s</CurrentURI><CurrentURIMetaData>%s"
                    "</CurrentURIMetaData>"
                    % (ct.escape(url), ct.didl(url, cls.items[i]["title"], path)))
            state = ct.tag(ct.soap(cls.avt, ct.AVT, "GetTransportInfo"),
                           "CurrentTransportState")
            if state in ("STOPPED", "NO_MEDIA_PRESENT"):
                ct.soap(cls.avt, ct.AVT, "Play", "<Speed>1</Speed>")
            with cls.lock:
                if gen == cls.generation:
                    cls.error = None
        except Exception as e:
            with cls.lock:
                if gen == cls.generation:
                    cls.error = "%s: %s" % (cls.items[i]["title"], e)
        finally:
            with cls.lock:
                if gen == cls.generation:
                    cls.loading = False
                    cls.shown_at = time.time()
                    # a picture jumped to while paused gets its whole time on
                    # resume, not what was left of the one before it
                    if cls.paused:
                        cls.paused_left = float(cls.interval)

    @classmethod
    def run(cls, gen):
        cls.put(gen, 0)
        while True:
            with cls.lock:
                if gen != cls.generation:
                    return
                target = cls.want
                cls.want = None
                if target is None and not cls.paused and \
                        time.time() >= cls.shown_at + cls.interval:
                    target = cls.idx + 1
                    if target >= len(cls.items):
                        cls.finish(gen)
                        return
            if target is not None:
                cls.put(gen, target)
            try:
                cls.resolve(cls.idx + 1)    # the next one, while this one shows
            except Exception:
                pass                        # it will say so when its turn comes
            cls.wake.wait(0.4)
            cls.wake.clear()

    @classmethod
    def start(cls, items, interval):
        Cast.stop()                 # the TV plays one thing, and a cast holds the port
        cls.end(quiet=True)
        tv = tv_address()
        if not tv:
            return {"error": "No TV chosen - find it first."}
        ct = casttv_module()
        avt, _ = ct.control_urls(tv)
        if not avt:
            return {"error": "%s does not expose AVTransport (switched off?)" % tv}
        server = None
        for _ in range(10):         # a cast that just stopped may still hold the port
            try:
                server = ct.Server(("0.0.0.0", cls.PORT), ct.RangeHandler)
                break
            except OSError:
                time.sleep(0.3)
        if server is None:
            return {"error": "Port %d is taken - is a cast still running?" % cls.PORT}
        threading.Thread(target=server.serve_forever, daemon=True).start()
        with cls.lock:
            cls.generation += 1
            gen = cls.generation
            cls.items, cls.urls, cls.idx, cls.want = list(items), {}, 0, None
            cls.interval, cls.paused, cls.error = interval, False, None
            cls.active, cls.ended, cls.loading = True, False, True
            cls.server, cls.avt = server, avt
            cls.base = "http://%s:%d" % (ct.local_ip(tv), cls.PORT)
        threading.Thread(target=cls.run, args=(gen,), daemon=True).start()
        return cls.state()

    @classmethod
    def control(cls, action, index=None, interval=None):
        with cls.lock:
            if not cls.active:
                return cls.state()
            if action == "pause" and not cls.paused:
                cls.paused = True
                cls.paused_left = max(0.0, cls.shown_at + cls.interval - time.time())
            elif action == "resume" and cls.paused:
                cls.paused = False
                cls.shown_at = time.time() - (cls.interval - cls.paused_left)
            elif action == "next":
                cls.want = (cls.idx + 1) % len(cls.items)
            elif action == "prev":
                cls.want = (cls.idx - 1) % len(cls.items)
            elif action == "goto" and isinstance(index, int) and 0 <= index < len(cls.items):
                cls.want = index
            elif action == "interval" and interval in (3, 5, 8, 12):
                cls.interval = interval
        cls.wake.set()
        return cls.state()

    @classmethod
    def finish(cls, gen):
        """The queue ran out: stop the TV, which goes back to its own input."""
        with cls.lock:
            if gen != cls.generation:
                return
        cls.end()

    @classmethod
    def end(cls, quiet=False):
        with cls.lock:
            if not cls.active:
                if quiet:
                    cls.ended = False
                return cls.state()
            cls.generation += 1
            cls.active, cls.paused, cls.loading = False, False, False
            cls.ended = not quiet
            server, avt = cls.server, cls.avt
            cls.server = None
        ct = casttv_module()
        try:
            ct.soap(avt, ct.AVT, "Stop")
        except Exception:
            pass
        if server:
            server.shutdown()
            server.server_close()
        ct.RangeHandler.remote = {}
        ct.RangeHandler.files = {}
        cls.wake.set()
        return cls.state()

    @classmethod
    def dismiss(cls):
        with cls.lock:
            cls.ended = False
        return cls.state()


def show_items(raw):
    """What makes a queue: photos of our own GoPro listing, and photos inside
    the OneDrive mirror. Whatever the page sends is checked against those,
    never passed on as it came."""
    listed = {i.get("id"): i for i in (cc.cache_read("gopro-list.json") or [])}
    out = []
    for r in raw if isinstance(raw, list) else []:
        if not isinstance(r, dict):
            continue
        meta = r.get("meta") if isinstance(r.get("meta"), str) else ""
        if r.get("source") == "gopro":
            item = listed.get(r.get("id"))
            if item is None or item.get("kind") != "Photo":
                continue
            thumb = thumb_for("gopro", item)
            out.append({"source": "gopro", "id": item["id"], "title": item.get("name"),
                        "thumb": thumb, "preview": thumb, "meta": meta})
        elif r.get("source") == "onedrive":
            full = onedrive_file(r.get("path"))
            if not full or not full.lower().endswith(PHOTO_EXT):
                continue
            st = os.stat(full)
            rel = os.path.relpath(full, os.path.realpath(onedrive_root()))
            item = {"name": os.path.basename(full), "path": rel, "kind": "photo",
                    "cloud": in_cloud_only(st)}
            out.append({"source": "onedrive", "path": rel, "full": full,
                        "title": item["name"], "cloud": item["cloud"],
                        "thumb": thumb_for("onedrive", item, str(int(st.st_mtime))),
                        # the whole photo for the preview on the page, but only one
                        # that is on disk: a cloud-only one would be fetched for it
                        "preview": None if item["cloud"] else
                                   "/api/onedrive/file?k=" + urllib.parse.quote(rel, safe=""),
                        "meta": meta})
    return out


def cast_command(req):
    """Build the command line this choice corresponds to, or say what is missing."""
    source = req.get("source")
    tv = tv_address()
    extra = ["-t", tv] if tv else []

    if source == "gopro":
        index = req.get("index")
        if not isinstance(index, int) or index < 1:
            return None, None, "No entry picked."
        quality = req.get("quality") or "auto"
        if quality not in ("auto", "source", "proxy"):
            return None, None, "Unknown quality %r." % quality
        cmd = cc.sibling("cast-gopro") + [str(index), "-q", quality] + extra
        return cmd, req.get("title") or ("GoPro #%d" % index), None

    if source == "photos":
        link = (req.get("link") or "").strip()
        if not link.startswith(("http://", "https://")):
            return None, None, "That is not a link to a Google Photos video."
        cmd = cc.sibling("cast-photos") + [link]
        cookies = (req.get("cookies") or "").strip()
        if cookies:
            cookies = os.path.expanduser(cookies)
            if not os.path.isfile(cookies):
                return None, None, "No cookie jar at %s." % cookies
            cmd += ["-c", cookies]
        photos_remember(link)
        return cmd + extra, "Google Photos", None

    if source == "onedrive":
        # the page may be open in a browser, so only the mirror is castable
        full = onedrive_file(req.get("path") or "")
        if not full:
            return None, None, "Not a file inside %s." % onedrive_root()
        if full.lower().endswith(".heic"):
            return None, None, "The TV cannot decode HEIC, and nothing here converts it."
        return cc.sibling("cast-tv") + [full] + extra, os.path.basename(full), None

    return None, None, "Unknown source %r." % source


