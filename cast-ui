    .tab .th { display: none; }
    .tab .tl { font-size: 13px; }
    #filters { display: none; }
    .strip { border-top: 1px solid var(--line-soft); }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .name { font-size: 11px; }
    .meta, .dur { font-size: 10px; }
    .check { width: 22px; height: 22px; right: 6px; top: 6px; }
    .flags { left: 6px; top: 6px; }
    #bar { gap: 11px 12px; padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); }
    /* the dot and the words centred together, as the artboard has them */
    #bar .bdot { margin-left: auto; }
    .bidle { flex: none; margin-right: auto; }
    .bthumb { width: 54px; height: 32px; }
    .bsub { display: none; }
    #bar .bbtn#stop { width: 46px; height: 46px; padding: 0; justify-content: center; }
    #bar .bstart { flex: 1; height: 46px; justify-content: center; font-size: 14.5px; }
    .panel .row { flex-direction: column; align-items: stretch; }
    .panel .row input, .panel .row .btn { height: 46px; width: 100%; flex: none; }
    /* The artboard has no phone slideshow. Stacked, the controls would sit
       under the queue, a scroll away from pausing it, so they stay pinned. */
    .svctl { position: sticky; bottom: 0; z-index: 5;
             padding-bottom: calc(12px + env(safe-area-inset-bottom)); }
    /* two rows that fit: the buttons with the countdown, then the interval
       and the end - the label and the next name have no room on a phone */
    .svctl .plbl, .svprogtop .mono { display: none; }
    .svprog { flex: 1 1 140px; }
    .svprogtop span:first-child { white-space: nowrap; }
    .svctl .ivs { flex: 1; justify-content: space-between; }
  }
  @media (max-width: 380px) {
    .grid { gap: 10px; }
  }
</style>
